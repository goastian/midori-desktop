{
  "manifest_version": 2,
  "name": "Midori Sidebar Action Test",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "msidebar-test@midori.local"
    }
  },
  "sidebar_action": {
    "default_title": "Fixture Sidebar",
    "default_panel": "sidebar/panel.html",
    "default_icon": {
      "16": "icons/sidebar-16.png",
      "32": "icons/sidebar-32.png"
    }
  },
  "icons": {
    "16": "icons/default-16.png",
    "32": "icons/default-32.png"
  }
}
