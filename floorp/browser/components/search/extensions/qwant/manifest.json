{
  "name": "Qwant",
  "description": "Private Search",
  "manifest_version": 2,
  "version": "1.1",
  "applications": {
    "gecko": {
      "id": "qwant@search.mozilla.org"
    }
  },
  "hidden": true,
  "icons": {
    "16": "favicon.ico"
  },
  "web_accessible_resources": ["favicon.ico"],
  "chrome_settings_overrides": {
    "search_provider": {
      "keyword": "@st",
      "name": "Qwant",
      "search_url": "https://www.qwant.com/sp/search",
      "search_form": "https://www.qwant.com",
      "search_url_post_params": "query={searchTerms}&segment=midoribrowser",
      "suggest_url": "https://www.qwant.com/suggestions",
      "suggest_url_get_params": "q={searchTerms}&format=opensearch"
    }
  }
}
