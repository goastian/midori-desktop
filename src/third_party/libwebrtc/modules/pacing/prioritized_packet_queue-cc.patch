+std::vector<uint16_t> PrioritizedPacketQueue::RemovePacketsCapturedBefore(
+    uint32_t ssrc, Timestamp time) {
+  std::vector<uint16_t> aborted;
+  auto found = streams_.find(ssrc);
+  if (found == streams_.end()) return aborted;
+  StreamQueue& stream = *found->second;
+  auto packets = stream.DequeueAll();
+  for (int priority = 0; priority < kNumPriorityLevels; ++priority) {
+    for (auto& packet : packets[priority]) {
+      if (packet.packet->capture_time() > Timestamp::Zero() &&
+          packet.packet->capture_time() < time) {
+        if (packet.packet->retransmitted_sequence_number()) {
+          aborted.push_back(*packet.packet->retransmitted_sequence_number());
+        }
+        DequeuePacketInternal(packet);
+      } else {
+        stream.EnqueuePacket(std::move(packet), priority);
+      }
+    }
+    if (!stream.HasPacketsAtPrio(priority)) {
+      std::erase(streams_by_prio_[priority], &stream);
+    }
+  }
+  MaybeUpdateTopPrioLevel();
+  return aborted;
 }
 
