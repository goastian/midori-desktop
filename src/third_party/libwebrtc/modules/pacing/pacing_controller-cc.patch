+TimeDelta PacingController::EffectiveSendBurstInterval() const {
+  TimeDelta interval = send_burst_interval_;
+#if defined(WEBRTC_LINUX) && !defined(WEBRTC_ANDROID)
+  const uint32_t state = MidoriWebRTCVideoBudgetState();
+  if (state == 1) {
+    interval = std::max(interval, TimeDelta::Millis(250));
+  } else if (state == 3) {
+    interval = std::max(interval, kMaxDebtInTime - TimeDelta::Millis(10));
+  }
+  if (midori_observed_burst_interval_ != interval) {
+    midori_observed_burst_interval_ = interval;
+    if (MidoriMediaTraceEnabled()) {
+      MidoriMediaTraceEncode(32, this, 0, nullptr, interval.ms<uint32_t>());
+    }
+  }
+#endif
+  return interval;
+}
