+void VideoSendStreamImpl::DiscardPacketsCapturedBefore(Timestamp time) {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  auto* sender = transport_->packet_sender();
+  for (uint32_t ssrc : config_.rtp.ssrcs) {
+    sender->DiscardPacketsCapturedBefore(ssrc, time);
+  }
+  for (uint32_t ssrc : config_.rtp.rtx.ssrcs) {
+    sender->DiscardPacketsCapturedBefore(ssrc, time);
+  }
+  if (config_.rtp.flexfec.ssrc) {
+    sender->DiscardPacketsCapturedBefore(config_.rtp.flexfec.ssrc, time);
+  }
+}
