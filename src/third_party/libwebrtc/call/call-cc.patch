 void Call::SetClientBitratePreferences(const BitrateSettings& preferences) {
   RTC_DCHECK_RUN_ON(worker_thread_);
+  client_bitrate_preferences_.emplace(preferences);
+  external_send_bitrate_bps_ =
+      config_.send_bitrate_limit_bps
+          ? std::max<int64_t>(0, config_.send_bitrate_limit_bps())
+          : 0;
+  ApplyClientBitratePreferences(preferences.start_bitrate_bps);
+}
+
+void Call::ApplyClientBitratePreferences(std::optional<int> start_bitrate_bps) {
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  BitrateSettings preferences =
+      client_bitrate_preferences_.value_or(BitrateSettings{});
+  preferences.start_bitrate_bps = start_bitrate_bps;
+  if (external_send_bitrate_bps_ > 0) {
+    const int limit = static_cast<int>(std::min<int64_t>(
+        external_send_bitrate_bps_, std::numeric_limits<int>::max()));
+    const int maximum =
+        std::min(preferences.max_bitrate_bps.value_or(limit), limit);
+    preferences.max_bitrate_bps = maximum;
+    preferences.min_bitrate_bps =
+        std::min(preferences.min_bitrate_bps.value_or(0), maximum);
+    if (preferences.start_bitrate_bps) {
+      preferences.start_bitrate_bps =
+          std::min(*preferences.start_bitrate_bps, maximum);
+    }
+  }
+  if (external_send_bitrate_bps_ > 0 && !external_video_suspended_ &&
+      preferences.max_bitrate_bps && applied_allocation_limits_ &&
+      applied_allocation_limits_->min_allocatable_rate >
+          DataRate::BitsPerSec(*preferences.max_bitrate_bps)) {
+    ApplyAllocationLimits();
+  }
   GetTransportControllerSend()->SetClientBitratePreferences(preferences);
+  ApplyAllocationLimits();
+}
+
+void Call::ApplyAllocationLimits() {
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  if (!allocation_limits_) return;
+  BitrateAllocationLimits limits = *allocation_limits_;
+  if (external_send_bitrate_bps_ > 0 && !external_video_suspended_) {
+    int64_t maximum = std::min<int64_t>(external_send_bitrate_bps_,
+                                        std::numeric_limits<int>::max());
+    if (client_bitrate_preferences_ &&
+        client_bitrate_preferences_->max_bitrate_bps) {
+      maximum = std::min<int64_t>(
+          maximum, *client_bitrate_preferences_->max_bitrate_bps);
+    }
+    const DataRate cap = DataRate::BitsPerSec(maximum);
+    limits.min_allocatable_rate = std::min(limits.min_allocatable_rate, cap);
+    limits.max_allocatable_rate = std::min(limits.max_allocatable_rate, cap);
+    limits.max_padding_rate = std::min(limits.max_padding_rate, cap);
+  }
+  if (applied_allocation_limits_ &&
+      applied_allocation_limits_->min_allocatable_rate ==
+          limits.min_allocatable_rate &&
+      applied_allocation_limits_->max_allocatable_rate ==
+          limits.max_allocatable_rate &&
+      applied_allocation_limits_->max_padding_rate == limits.max_padding_rate) {
+    return;
+  }
+  transport_send_->SetAllocatedSendBitrateLimits(limits);
+  send_stats_.SetMinAllocatableRate(limits);
+  configured_max_padding_bitrate_bps_ = limits.max_padding_rate.bps();
+  applied_allocation_limits_ = limits;
+}
+
+void Call::UpdateExternalBitrateLimits() {
+  RTC_DCHECK_RUN_ON(worker_thread_);
+  const bool suspended =
+      config_.video_send_suspended && config_.video_send_suspended();
+  if (suspended && !external_video_suspended_) {
+    external_video_pause_started_ =
+        Timestamp::Millis(env_.clock().CurrentTime().ms());
+  }
+  const bool video_suspend_changed = external_video_suspended_ != suspended;
+  const bool resume_video = external_video_suspended_ && !suspended;
+  external_video_suspended_ = suspended;
+  if (config_.send_bitrate_limit_bps) {
+    const int64_t limit = std::max<int64_t>(0, config_.send_bitrate_limit_bps());
+    if (limit != external_send_bitrate_bps_ || video_suspend_changed) {
+      external_send_bitrate_bps_ = limit;
+      ApplyClientBitratePreferences();
+    }
+  }
+  if (config_.receive_bitrate_limit_bps) {
+    const int64_t limit = std::max<int64_t>(0, config_.receive_bitrate_limit_bps());
+    if (limit != external_receive_bitrate_bps_) {
+      external_receive_bitrate_bps_ = limit;
+      // Receive estimates use uint32_t, so this removes the external bound.
+      const int64_t maximum =
+          limit > 0 ? limit : std::numeric_limits<uint32_t>::max();
+      receive_side_cc_.SetMaxDesiredReceiveBitrate(DataRate::BitsPerSec(maximum));
+    }
+  }
+  if (resume_video) {
+    const Timestamp transition = external_video_pause_started_;
+    for (auto* stream : video_send_streams_) {
+      if (stream->started()) stream->DiscardPacketsCapturedBefore(transition);
+    }
+    for (auto* stream : video_send_streams_) {
+      if (stream->started()) stream->GenerateKeyFrame({});
+    }
+  }
 }
 
