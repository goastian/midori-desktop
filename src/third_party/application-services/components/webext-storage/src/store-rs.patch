+    pub fn compare_and_replace(
+        &self,
+        ext_id: &str,
+        expected: JsonValue,
+        desired: JsonValue,
+    ) -> Result<Option<StorageChanges>> {
+        let expected: serde_json::Map<String, JsonValue> = serde_json::from_value(expected)?;
+        let desired: serde_json::Map<String, JsonValue> = serde_json::from_value(desired)?;
+        let db = &self.db.lock();
+        let conn = db.get_connection()?;
+        let tx = conn.unchecked_transaction()?;
+        if read_sync_snapshot(&tx, ext_id)?.as_object() != Some(&expected) {
+            return Ok(None);
+        }
+        let removed = expected
+            .keys()
+            .filter(|key| !desired.contains_key(*key))
+            .cloned()
+            .map(JsonValue::String)
+            .collect();
+        let mut changes = api::remove(&tx, ext_id, JsonValue::Array(removed))?;
+        let changed = desired
+            .into_iter()
+            .filter(|(key, value)| expected.get(key) != Some(value))
+            .collect();
+        let updated = api::set(&tx, ext_id, JsonValue::Object(changed))?;
+        changes.changes.extend(updated.changes);
+        tx.commit()?;
+        Ok(Some(changes))
     }
 
