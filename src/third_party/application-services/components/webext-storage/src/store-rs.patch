 use interrupt_support::SqlInterruptHandle;
 use serde_json::Value as JsonValue;
+use sql_support::ConnExt;
+
+fn read_sync_snapshot(conn: &rusqlite::Connection, ext_id: &str) -> Result<JsonValue> {
+    let saved = conn
+        .try_query_one::<Option<String>, _>(
+            "SELECT data FROM storage_sync_data WHERE ext_id = :ext_id",
+            &[(":ext_id", &ext_id)],
+            true,
+        )?
+        .flatten();
+    let data = match saved {
+        Some(text) => {
+            if text.len() > 2 * 1024 * 1024 {
+                return Err(Error::QuotaError(QuotaReason::TotalBytes));
+            }
+            serde_json::from_str::<serde_json::Map<String, JsonValue>>(&text)?
+        }
+        None => serde_json::Map::new(),
+    };
+    Ok(JsonValue::Object(data))
+}
 
