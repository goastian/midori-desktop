+            password: "public old fixture".into(),
+            ..Default::default()
+        };
+        let initial = db.add(entry.clone()).unwrap();
+        let id = initial.meta.id.clone();
+        let mut meta = initial.meta.clone();
+        meta.time_created = 1_700_000_000_000;
+        meta.time_password_changed = 1_700_000_001_000;
+        meta.time_last_used = 0;
+        meta.times_used = 0;
+        let mut incoming = LoginEntryWithMeta {
+            entry: LoginEntry {
+                password: "public received fixture".into(),
+                ..entry
+            },
+            meta,
+        };
+        let applied = db
+            .update_with_meta(
+                &id,
+                LoginEntryWithMeta {
+                    entry: incoming.entry.clone(),
+                    meta: incoming.meta.clone(),
+                },
+            )
+            .unwrap();
+        let expected_meta = applied.meta.clone();
+        assert_eq!(applied.meta.time_created, incoming.meta.time_created);
+        assert_eq!(
+            applied.meta.time_password_changed,
+            incoming.meta.time_password_changed
+        );
+        assert_eq!(applied.meta.time_last_used, 0);
+        assert_eq!(applied.meta.times_used, 0);
+        assert_eq!(
+            applied.decrypt(db.encdec.as_ref()).unwrap().password,
+            incoming.entry.password
+        );
+        incoming.meta.id = Guid::random().to_string();
+        assert!(db.update_with_meta(&id, incoming).is_err());
+        let stored = db.get_by_id(&id).unwrap().unwrap();
+        assert_eq!(stored.meta.time_created, expected_meta.time_created);
+        assert_eq!(stored.meta.time_last_used, 0);
+        assert_eq!(stored.meta.times_used, 0);
+        assert_eq!(
+            stored.meta.time_password_changed,
+            expected_meta.time_password_changed
+        );
+        assert_eq!(
+            stored.decrypt(db.encdec.as_ref()).unwrap().password,
+            "public received fixture"
+        );
+    }
