+    #[test]
+    fn test_adopt_guid_preserves_usage_and_reencrypts_for_remote_identity() {
+        ensure_initialized();
+        let db = LoginDb::open_in_memory();
+        let local = identity_fixture(&db);
+        let id = local.meta.id.clone();
+        let target = Guid::random().to_string();
+        let mut replacement = identity_snapshot(&db, &id);
+        let expected = identity_snapshot(&db, &id);
+        db.touch(&id).unwrap();
+        let used = db.get_by_id(&id).unwrap().unwrap().meta;
+        replacement.meta.id = target.clone();
+        replacement.meta.time_created = 1_700_000_000_000;
+        replacement.meta.time_password_changed = 1_700_000_001_000;
+        replacement.meta.times_used = 999;
+        replacement.meta.time_last_used = 0;
+        replacement.entry.username_field = "received-user".into();
+        let applied = db.adopt_guid(expected, replacement).unwrap().unwrap();
+        assert_eq!(applied.meta.id, target);
+        assert_eq!(applied.meta.time_created, 1_700_000_000_000);
+        assert_eq!(applied.meta.time_password_changed, 1_700_000_001_000);
+        assert_eq!(applied.meta.times_used, used.times_used);
+        assert_eq!(applied.meta.time_last_used, used.time_last_used);
+        assert!(db.get_by_id(&id).unwrap().is_none());
+        let read = db.get_by_id(&target).unwrap().unwrap();
+        assert_eq!(applied, read);
+        let decrypted = read.decrypt(db.encdec.as_ref()).unwrap();
+        assert_eq!(decrypted.password, "public identity fixture");
+        assert_eq!(decrypted.username_field, "received-user");
+        let (deleted, secret): (bool, String) = db
+            .query_row(
+                "SELECT is_deleted, secFields FROM loginsL WHERE guid = ?1",
+                [&id],
+                |row| Ok((row.get(0)?, row.get(1)?)),
+            )
+            .unwrap();
+        assert!(deleted);
+        assert!(secret.is_empty());
+    }
