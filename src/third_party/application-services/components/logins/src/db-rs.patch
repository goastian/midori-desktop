+    #[test]
+    fn test_delete_if_current_handles_mirror_only_and_rolls_back_errors() {
+        ensure_initialized();
+        for mirror_only in [false, true] {
+            for reject_write in [false, true] {
+                let db = LoginDb::open_in_memory();
+                let original = identity_fixture(&db);
+                let id = original.meta.id.clone();
+                test_utils::add_mirror(&db, &original, &sync15::ServerTimestamp(1), false).unwrap();
+                if mirror_only {
+                    db.execute("DELETE FROM loginsL WHERE guid = ?1", [&id])
+                        .unwrap();
+                }
+                let expected = identity_snapshot(&db, &id);
+                if reject_write {
+                    db.execute_batch(
+                        "CREATE TRIGGER reject_sync_delete BEFORE UPDATE ON loginsM
+                        WHEN NEW.is_overridden = 1
+                        BEGIN SELECT RAISE(ABORT, 'synthetic Sync deletion failure'); END",
+                    )
+                    .unwrap();
+                }
+                let result = db.delete_if_current(expected);
+                let overridden: bool = db
+                    .query_row(
+                        "SELECT is_overridden FROM loginsM WHERE guid = ?1",
+                        [&id],
+                        |row| row.get(0),
+                    )
+                    .unwrap();
+                if reject_write {
+                    assert!(result.is_err());
+                    assert!(!overridden);
+                    assert_eq!(db.get_by_id(&id).unwrap().unwrap(), original);
+                    let local_exists: bool = db
+                        .query_row(
+                            "SELECT EXISTS(SELECT 1 FROM loginsL WHERE guid = ?1)",
+                            [&id],
+                            |row| row.get(0),
+                        )
+                        .unwrap();
+                    assert_eq!(local_exists, !mirror_only);
+                } else {
+                    assert!(
+                        result.unwrap(),
+                        "A mirror-only deletion also reports success"
+                    );
+                    assert!(overridden);
+                    assert!(db.get_by_id(&id).unwrap().is_none());
+                }
+            }
+        }
+    }
