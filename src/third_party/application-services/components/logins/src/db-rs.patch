+    #[test]
+    fn test_adopt_guid_rejects_stale_native_data_and_occupied_identities() {
+        ensure_initialized();
+        let db = LoginDb::open_in_memory();
+        let id = identity_fixture(&db).meta.id;
+        let expected = identity_snapshot(&db, &id);
+        let mut replacement = identity_snapshot(&db, &id);
+        replacement.meta.id = Guid::random().to_string();
+        let target = replacement.meta.id.clone();
+        let mut changed = expected.entry.clone();
+        changed.password = "public local edit".into();
+        db.update(&id, changed).unwrap();
+        assert!(db.adopt_guid(expected, replacement).unwrap().is_none());
+        assert!(db.get_by_id(&target).unwrap().is_none());
+        assert_eq!(
+            db.get_by_id(&id)
+                .unwrap()
+                .unwrap()
+                .decrypt(db.encdec.as_ref())
+                .unwrap()
+                .password,
+            "public local edit"
+        );
+        let occupied = db
+            .add(LoginEntry {
+                origin: "https://occupied.example.invalid".into(),
+                http_realm: Some("fixture".into()),
+                password: "public occupied fixture".into(),
+                ..Default::default()
+            })
+            .unwrap();
+        let target = occupied.meta.id.clone();
+        for deleted in [false, true] {
+            if deleted {
+                db.delete(&target).unwrap();
+            }
+            let mut replacement = identity_snapshot(&db, &id);
+            replacement.meta.id = target.clone();
+            assert!(db
