+NS_IMETHODIMP
+Preferences::FlushPrefFile(JSContext* aCx, Promise** aPromise) {
+  MOZ_ASSERT(NS_IsMainThread());
+  ENSURE_PARENT_PROCESS("Preferences::FlushPrefFile", "all prefs");
+  if (sPImpl->mProfileShutdown) {
+    return NS_ERROR_ILLEGAL_DURING_SHUTDOWN;
+  }
+  if (!sPImpl->mCurrentFile) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  ErrorResult result;
+  RefPtr<Promise> promise =
+      Promise::Create(xpc::CurrentNativeGlobal(aCx), result);
+  if (result.Failed()) {
+    return result.StealNSResult();
+  }
+  nsresult rv = SavePrefFileAsynchronous();
+  if (NS_FAILED(rv)) {
+    promise->MaybeReject(rv);
+  } else if (!sPImpl->mAsyncTarget) {
+    promise->MaybeResolveWithUndefined();
+  } else {
+    nsMainThreadPtrHandle<Promise> holder(new nsMainThreadPtrHolder<Promise>(
+        "Preferences::FlushPrefFile promise", promise));
+    rv = sPImpl->mAsyncTarget->Dispatch(
+        NS_NewRunnableFunction(
+            "Preferences::FlushPrefFile",
+            [holder] {
+              const nsresult writeResult =
+                  PreferencesWriter::sLastProfileWriteResult;
+              SchedulerGroup::Dispatch(NS_NewRunnableFunction(
+                  "Preferences::FlushPrefFileComplete", [holder, writeResult] {
+                    if (NS_FAILED(writeResult)) {
+                      holder.get()->MaybeReject(writeResult);
+                    } else {
+                      holder.get()->MaybeResolveWithUndefined();
+                    }
+                  }));
+            }),
+        nsIEventTarget::DISPATCH_EVENT_MAY_BLOCK);
+    if (NS_FAILED(rv)) {
+      promise->MaybeReject(rv);
+    }
+  }
+  promise.forget(aPromise);
+  return NS_OK;
 }
 
 NS_IMETHODIMP
