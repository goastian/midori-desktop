  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#080D14",
      "frame_inactive": "#060a10",
      "tab_background_text": "#C4F0E0",
      "tab_text": "#C4F0E0",
      "tab_loading": "#04A469",
      "tab_line": "#04A469",
      "toolbar": "#0F1520",
      "toolbar_text": "#C4F0E0",
      "toolbar_field": "#1E2D3D",
      "toolbar_field_text": "#C4F0E0",
      "toolbar_field_border": "#1D3530",
      "toolbar_field_focus": "#243545",
