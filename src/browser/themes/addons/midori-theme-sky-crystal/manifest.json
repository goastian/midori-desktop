{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-sky-crystal@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.0.0",
  "name": "Midori — Slate Tide",
  "description": "Gris pizarra sofisticado con acentos verde esmeralda. Sobrio y profesional.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#F7F9FB",
      "frame_inactive": "#f0f3f6",
      "tab_background_text": "#2D4459",
      "tab_text": "#2D4459",
      "tab_loading": "#04A469",
      "tab_line": "#04A469",
      "toolbar": "#EEF2F5",
      "toolbar_text": "#2D4459",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#2D4459",
      "toolbar_field_border": "#C5D3DE",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#2D4459",
      "toolbar_field_border_focus": "#04A469",
      "toolbar_field_highlight": "#dce5ed",
      "toolbar_field_highlight_text": "#2D4459",
      "toolbar_top_separator": "transparent",
