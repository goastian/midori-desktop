  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#F6F8FA",
      "frame_inactive": "#eff2f5",
      "tab_background_text": "#28323B",
