{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-sky-crystal@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.2.0",
  "name": "Midori — Slate Tide",
  "description": "Pizarra sofisticada con firma teal Astian. Sobrio, profesional y premium.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "images": {
      "additional_backgrounds": [
        "header.svg"
      ]
    },
    "colors": {
      "frame": "#F5FAFF",
      "frame_inactive": "#E9F1F8",
      "tab_background_text": "#28323B",
      "tab_text": "#28323B",
      "tab_loading": "#2DA9E8",
      "tab_line": "#2DA9E8",
      "toolbar": "#EAF3F8",
      "toolbar_text": "#28323B",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#28323B",
      "toolbar_field_border": "#C3D1DB",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#28323B",
      "toolbar_field_border_focus": "#2DA9E8",
      "toolbar_field_highlight": "#DCECF7",
      "toolbar_field_highlight_text": "#28323B",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#C3D1DB",
      "ntp_background": "#F6F8FA",
      "ntp_card_background": "#ffffff",
      "ntp_text": "#28323B",
      "popup": "#EEF5F9",
      "popup_text": "#28323B",
      "popup_border": "#C3D1DB",
      "popup_highlight": "#DCECF7",
      "popup_highlight_text": "#28323B",
      "sidebar": "#EAF3F8",
      "sidebar_text": "#28323B",
      "sidebar_highlight": "#D3E6F2",
      "sidebar_highlight_text": "#28323B",
      "sidebar_border": "#C3D1DB",
      "icons": "#457792",
      "icons_attention": "#2DA9E8",
      "button_background_hover": "#DCECF7",
      "button_background_active": "#C3D1DB"
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "right top"
      ],
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "color_scheme": "light",
      "content_color_scheme": "auto"
    }
  },
  "theme_experiment": {
    "colors": {},
    "properties": {}
  }
}
