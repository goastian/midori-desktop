{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-sky-crystal@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.1.0",
  "name": "Midori — Slate Tide",
