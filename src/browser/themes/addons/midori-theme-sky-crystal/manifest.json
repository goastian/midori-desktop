      "ntp_card_background": "#ffffff",
      "ntp_text": "#2D4459",
      "popup": "#EEF2F5",
      "popup_text": "#2D4459",
      "popup_border": "#C5D3DE",
      "popup_highlight": "#dce5ed",
      "popup_highlight_text": "#2D4459",
      "sidebar": "#EEF2F5",
      "sidebar_text": "#2D4459",
      "sidebar_highlight": "#d0dbe5",
      "sidebar_highlight_text": "#2D4459",
      "sidebar_border": "#C5D3DE",
      "icons": "#5A7A8E",
      "icons_attention": "#04A469",
      "button_background_hover": "#dce5ed",
      "button_background_active": "#C5D3DE"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "auto"
