  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#DDEFE3",
      "frame_inactive": "#D3E9DA",
      "tab_background_text": "#142A24",
      "tab_text": "#142A24",
      "tab_loading": "#0EAE5B",
      "tab_line": "#0EAE5B",
      "toolbar": "#DDEFE3",
      "toolbar_text": "#142A24",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#142A24",
      "toolbar_field_border": "#A9D2B7",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#142A24",
