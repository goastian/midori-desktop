{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-jade-mist@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "1.0.0",
  "name": "Midori — Jade Mist",
