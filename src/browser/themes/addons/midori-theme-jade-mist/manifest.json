{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-jade-mist@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.2.0",
  "name": "Midori — Midori Breeze",
  "description": "Tema insignia de Midori. Menta-teal sereno con firma teal Astian. Premium, ligero y sin ruido.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "images": {
      "additional_backgrounds": [
        "header.svg"
      ]
    },
    "colors": {
      "frame": "#E0F7EA",
      "frame_inactive": "#CFEFDD",
      "tab_background_text": "#142A24",
      "tab_text": "#142A24",
      "tab_loading": "#00B98F",
      "tab_line": "#00B98F",
      "toolbar": "#DFF4E9",
      "toolbar_text": "#142A24",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#142A24",
      "toolbar_field_border": "#A9D2B7",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#142A24",
      "toolbar_field_border_focus": "#00B98F",
      "toolbar_field_highlight": "#C4F0DE",
      "toolbar_field_highlight_text": "#142A24",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#A9D2B7",
      "ntp_background": "#F1FBF5",
      "ntp_card_background": "#ffffff",
      "ntp_text": "#142A24",
      "popup": "#E7F6F0",
      "popup_text": "#142A24",
      "popup_border": "#A9D2B7",
      "popup_highlight": "#C5E6DD",
      "popup_highlight_text": "#142A24",
      "sidebar": "#DDF3EA",
      "sidebar_text": "#142A24",
      "sidebar_highlight": "#BFE2D8",
      "sidebar_highlight_text": "#142A24",
      "sidebar_border": "#A9D2B7",
      "icons": "#0B8090",
      "icons_attention": "#00B98F",
      "button_background_hover": "#C4F0DE",
      "button_background_active": "#A9D2B7"
    },
    "properties": {
      "additional_backgrounds_alignment": [
        "right top"
      ],
      "additional_backgrounds_tiling": [
        "no-repeat"
      ],
      "color_scheme": "light",
      "content_color_scheme": "auto"
    }
  },
  "theme_experiment": {
    "colors": {},
    "properties": {}
  }
}
