      "tab_loading": "#2e7d32",
      "tab_line": "#43a047",
      "toolbar": "rgba(200, 230, 201, 0.62)",
      "toolbar_text": "#1a3a1a",
      "toolbar_field": "rgba(255, 255, 255, 0.55)",
