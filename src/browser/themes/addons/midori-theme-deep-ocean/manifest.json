{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-deep-ocean@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.0.0",
  "name": "Midori — Onyx & Jade",
  "description": "Negro carbón profundo con jade translúcido. Lujo discreto, como un reloj de alta gama.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#0E0E0E",
      "frame_inactive": "#0a0a0a",
      "tab_background_text": "#E8FBF3",
      "tab_text": "#E8FBF3",
      "tab_loading": "#04A469",
      "tab_line": "#04A469",
      "toolbar": "#1A1A1A",
      "toolbar_text": "#E8FBF3",
      "toolbar_field": "#242424",
      "toolbar_field_text": "#E8FBF3",
      "toolbar_field_border": "#2E3D36",
      "toolbar_field_focus": "#2a2a2a",
      "toolbar_field_text_focus": "#E8FBF3",
      "toolbar_field_border_focus": "#04A469",
      "toolbar_field_highlight": "#2E3D36",
      "toolbar_field_highlight_text": "#E8FBF3",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#242424",
      "ntp_background": "#0E0E0E",
      "ntp_card_background": "#1A1A1A",
      "ntp_text": "#E8FBF3",
      "popup": "#1A1A1A",
      "popup_text": "#E8FBF3",
      "popup_border": "#2E3D36",
      "popup_highlight": "#2E3D36",
      "popup_highlight_text": "#E8FBF3",
      "sidebar": "#141414",
      "sidebar_text": "#E8FBF3",
      "sidebar_highlight": "#2E3D36",
      "sidebar_highlight_text": "#E8FBF3",
      "sidebar_border": "#242424",
      "icons": "#B8F0D6",
      "icons_attention": "#04A469",
      "button_background_hover": "#242424",
      "button_background_active": "#2E3D36"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "auto"
    }
