      "popup_highlight_text": "#1A2E22",
      "sidebar": "#E2EBE4",
      "sidebar_text": "#1A2E22",
      "sidebar_highlight": "#b8d5c5",
      "sidebar_highlight_text": "#1A2E22",
      "sidebar_border": "#9BBFAA",
      "icons": "#2E5040",
      "icons_attention": "#06E290",
      "button_background_hover": "#c8e0d2",
      "button_background_active": "#9BBFAA"
