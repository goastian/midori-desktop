{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-volcanic-sunset@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.1.0",
  "name": "Midori — Ink & Mint",
  "description": "Tinta profunda con firma teal Astian de alto impacto. Elegante, premium y muy legible.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#F4F7F6",
      "frame_inactive": "#edf1f0",
      "tab_background_text": "#122019",
      "tab_text": "#122019",
      "tab_loading": "#0EA5B7",
      "tab_line": "#0EA5B7",
      "toolbar": "#E4ECE9",
      "toolbar_text": "#122019",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#122019",
      "toolbar_field_border": "#A6C6BC",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#122019",
      "toolbar_field_border_focus": "#0EA5B7",
      "toolbar_field_highlight": "#C9EEF2",
      "toolbar_field_highlight_text": "#122019",
      "toolbar_top_separator": "transparent",
      "toolbar_bottom_separator": "#A6C6BC",
      "ntp_background": "#F4F7F6",
      "ntp_card_background": "#ffffff",
      "ntp_text": "#122019",
      "popup": "#E4ECE9",
      "popup_text": "#122019",
      "popup_border": "#A6C6BC",
      "popup_highlight": "#cfe7df",
      "popup_highlight_text": "#122019",
      "sidebar": "#E4ECE9",
      "sidebar_text": "#122019",
      "sidebar_highlight": "#bfe0d6",
      "sidebar_highlight_text": "#122019",
      "sidebar_border": "#A6C6BC",
      "icons": "#0B7C8B",
      "icons_attention": "#0EA5B7",
      "button_background_hover": "#cfe7df",
      "button_background_active": "#A6C6BC"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "auto"
    }
  },
  "theme_experiment": {
    "colors": {},
    "properties": {}
  }
