{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "midori-theme-volcanic-sunset@midori.astian.org",
      "strict_min_version": "120.0"
    }
  },
  "version": "2.0.0",
  "name": "Midori — Ink & Mint",
  "description": "Tinta profunda con destellos menta. Elegante, de alto impacto y muy legible.",
  "author": "Astian, Inc.",
  "icons": {
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "theme": {
    "colors": {
      "frame": "#F5F7F5",
      "frame_inactive": "#eef1ee",
      "tab_background_text": "#1A2E22",
      "tab_text": "#1A2E22",
      "tab_loading": "#06E290",
      "tab_line": "#06E290",
      "toolbar": "#E2EBE4",
      "toolbar_text": "#1A2E22",
      "toolbar_field": "#ffffff",
      "toolbar_field_text": "#1A2E22",
      "toolbar_field_border": "#9BBFAA",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#1A2E22",
      "toolbar_field_border_focus": "#06E290",
