+#if defined(XP_LINUX) && !defined(ANDROID)
+static bool PrepareMidoriCpuBudget(mozilla::midori::LinuxCpuBudget& aBudget) {
+  const char* text = getenv("MIDORI_CPU_BUDGET_FD");
+  if (!text) return false;
+  char* end = nullptr;
+  errno = 0;
+  long descriptor = strtol(text, &end, 10);
+  bool valid = !errno && end != text && !*end && descriptor >= 3 &&
+               descriptor <= INT_MAX;
+  unsetenv("MIDORI_CPU_BUDGET_FD");
+  if (!valid) return false;
+  int group = int(descriptor);
+  int flags = fcntl(group, F_GETFD);
+  if (flags < 0) return false;
+  auto closeGroup = mozilla::MakeScopeExit([group] { close(group); });
+  if (fcntl(group, F_SETFD, flags | FD_CLOEXEC) < 0) return false;
+  return aBudget.Initialize(group) == 0;
+}
+#elif defined(XP_WIN)
+static bool PrepareMidoriCpuBudget(mozilla::midori::WindowsCpuBudget& aBudget) {
+  const char* text = getenv("MIDORI_CPU_BUDGET_WINDOWS");
+  if (!text) return false;
+  const bool requested = !strcmp(text, "1");
+  int crtError = _putenv_s("MIDORI_CPU_BUDGET_WINDOWS", "");
+  BOOL cleared = SetEnvironmentVariableW(L"MIDORI_CPU_BUDGET_WINDOWS", nullptr);
+  if (crtError || (!cleared && GetLastError() != ERROR_ENVVAR_NOT_FOUND))
+    return false;
+  return requested && aBudget.InitializeNormalized(
+                          GetCurrentProcess(),
+                          mozilla::midori::gMidoriCpuParent) == ERROR_SUCCESS;
+}
+#endif
