+static int ConsumeMidoriCpuDescriptor(const char* aName, bool& aPresent) {
+  const char* text = getenv(aName);
+  aPresent = text != nullptr;
+  if (!text) return -1;
+  char* end = nullptr;
+  errno = 0;
+  long descriptor = strtol(text, &end, 10);
+  bool valid = !errno && end != text && !*end && descriptor >= 3 &&
+               descriptor <= INT_MAX;
+  unsetenv(aName);
+  if (!valid) return -1;
+  int file = int(descriptor);
+  int flags = fcntl(file, F_GETFD);
+  if (flags < 0) return -1;
+  if (fcntl(file, F_SETFD, flags | FD_CLOEXEC) < 0) {
+    close(file);
+    return -1;
+  }
+  return file;
+}
+
+static bool PrepareMidoriCpuChild() {
+  bool present;
+  int file = ConsumeMidoriCpuDescriptor("MIDORI_CPU_CHILD_FD", present);
+  if (!present) return true;
+  if (file < 0) return false;
+  int error = mozilla::midori::LinuxCpuBudget::JoinChildProcessFile(file);
+  close(file);
+  return error == 0;
+}
+
+static int PrepareDelegatedMidoriCpuBudget(
+    mozilla::midori::LinuxCpuBudget& aBudget) {
+  bool restoreFailed = false;
+  int error = aBudget.InitializeDelegated(restoreFailed);
+  if (restoreFailed) {
+    fprintf(stderr, "Midori CPU startup restoration failed: %d\n", error);
+    return -1;
+  }
+  return error ? 0 : 1;
+}
+
+static int PrepareMidoriCpuBudget(mozilla::midori::LinuxCpuBudget& aBudget,
+                                  bool& aDeferred) {
+  aDeferred = false;
+  const char* wait = getenv("MIDORI_CPU_RESTART_WAIT");
+  const bool restarting = wait != nullptr;
+  const bool validRestart = wait && !strcmp(wait, "1");
+  unsetenv("MIDORI_CPU_RESTART_WAIT");
+  unsetenv("MIDORI_CPU_CHILD_FD");
+  bool groupPresent, externalPresent;
+  int group = ConsumeMidoriCpuDescriptor("MIDORI_CPU_BUDGET_FD", groupPresent);
+  int external =
+      ConsumeMidoriCpuDescriptor("MIDORI_CPU_EXTERNAL_FD", externalPresent);
+  auto closeGroups = mozilla::MakeScopeExit([group, external] {
+    if (group >= 0) close(group);
+    if (external >= 0 && external != group) close(external);
+  });
+  if (!groupPresent && !externalPresent && !restarting) {
+    aDeferred = true;
+    return 0;
+  }
+  if (!groupPresent || group < 0 || (externalPresent && external < 0))
+    return restarting ? -1 : 0;
+  if (restarting) {
+    int error = validRestart && externalPresent
+                    ? mozilla::midori::LinuxCpuBudget::WaitAndJoinRestartGroup(
+                          group, external)
+                    : EINVAL;
+    if (error) {
+      fprintf(stderr, "Midori CPU restart handoff failed: %d\n", error);
+      return -1;
+    }
+  }
+  int error = aBudget.Initialize(group, external);
+  if (error && restarting) {
+    fprintf(stderr, "Midori CPU restart initialization failed: %d\n", error);
+    return -1;
+  }
+  return error ? 0 : 1;
+}
+#elif defined(XP_WIN)
+static bool PrepareMidoriCpuBudget(mozilla::midori::WindowsCpuBudget& aBudget) {
