XPIDL_SOURCES += [
    "nsIMidoriBlocker.idl",
]

XPIDL_MODULE = "midori_blocker"

UNIFIED_SOURCES += [
    "MidoriBlockerXPCOM.cpp",
]

EXPORTS += [
    "MidoriBlockerXPCOM.h",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

JAR_MANIFESTS += [
    "jar.mn",
]

EXTRA_JS_MODULES += [
    "MidoriBlockedPage.sys.mjs",
    "MidoriBlockedPageChild.sys.mjs",
    "MidoriBlockedPageParent.sys.mjs",
    "MidoriBlocker.sys.mjs",
    "MidoriBlockerChild.sys.mjs",
    "MidoriBlockerExtensionDetector.sys.mjs",
    "MidoriBlockerPanel.sys.mjs",
    "MidoriBlockerParent.sys.mjs",
    "MidoriBlockerService.sys.mjs",
    "MidoriBlockerUtils.sys.mjs",
]

EXTRA_JS_MODULES.internal += [
    "internal/EngineCache.sys.mjs",
    "internal/LegacyMigration.sys.mjs",
    "internal/ListCatalog.sys.mjs",
    "internal/ListPreprocessor.sys.mjs",
    "internal/ListStore.sys.mjs",
    "internal/ListUpdates.sys.mjs",
    "internal/RemoteResources.sys.mjs",
    "internal/Resources.sys.mjs",
    "internal/SiteExceptions.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"

LICENSES += ["cc-by-3.0", "gpl-3.0"]
LICENSES["cc-by-3.0"].title = "Creative Commons Attribution 3.0 Unported License"
LICENSES["cc-by-3.0"].text = "licenses/cc-by-3.0.txt"
LICENSES["cc-by-3.0"].spdx = "CC-BY-3.0"
LICENSES["gpl-3.0"].title = "GNU General Public License 3.0"
LICENSES["gpl-3.0"].text = "licenses/gpl-3.0.txt"
LICENSES["gpl-3.0"].spdx = "GPL-3.0-only"
LICENSES["gpl-3.0"].notice = """
<p>EasyList and EasyPrivacy are dual licensed by the EasyList authors.
Midori uses the GNU General Public License version 3 license option
for those bundled fallback files.</p>
"""

LICENSED_UNDER += ["cc-by-3.0", "gpl-3.0", "mpl"]
LICENSED_UNDER["cc-by-3.0"].paths = ["assets/filters/easylist-cookie.txt"]
LICENSED_UNDER["gpl-3.0"].paths = [
    "assets/filters/adguard-tracking-protection.txt",
    "assets/filters/easylist.txt",
    "assets/filters/easyprivacy.txt",
    "assets/filters/ublock-annoyances-cookies.txt",
    "assets/filters/ublock-badware.txt",
    "assets/filters/ublock-filters.txt",
    "assets/filters/ublock-filters-2020.txt",
    "assets/filters/ublock-filters-2021.txt",
    "assets/filters/ublock-filters-2022.txt",
    "assets/filters/ublock-filters-2023.txt",
    "assets/filters/ublock-filters-2024.txt",
    "assets/filters/ublock-filters-2025.txt",
    "assets/filters/ublock-filters-2026.txt",
    "assets/filters/ublock-filters-general.txt",
    "assets/filters/ublock-privacy.txt",
    "assets/filters/ublock-quick-fixes.txt",
    "assets/filters/ublock-resource-abuse.txt",
    "assets/filters/ublock-unbreak.txt",
    "assets/resources/resources.json",
    "assets/resources/ubo-scriptlets.json",
]
LICENSED_UNDER["mpl"].paths = ["assets/resources/resources.json"]
