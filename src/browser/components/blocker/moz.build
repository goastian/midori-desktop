XPIDL_SOURCES += [
    "nsIMidoriBlocker.idl",
]

XPIDL_MODULE = "midori_blocker"

UNIFIED_SOURCES += [
    "MidoriBlockerXPCOM.cpp",
]

EXPORTS += [
    "MidoriBlockerXPCOM.h",
]

XPCOM_MANIFESTS += [
    "components.conf",
]

JAR_MANIFESTS += [
    "jar.mn",
]

EXTRA_JS_MODULES += [
    "MidoriBlockedPage.sys.mjs",
    "MidoriBlockedPageChild.sys.mjs",
    "MidoriBlockedPageParent.sys.mjs",
    "MidoriBlocker.sys.mjs",
    "MidoriBlockerChild.sys.mjs",
    "MidoriBlockerExtensionDetector.sys.mjs",
    "MidoriBlockerPanel.sys.mjs",
    "MidoriBlockerParent.sys.mjs",
    "MidoriBlockerService.sys.mjs",
    "MidoriBlockerUtils.sys.mjs",
]

EXTRA_JS_MODULES.internal += [
    "internal/EngineCache.sys.mjs",
    "internal/LegacyMigration.sys.mjs",
    "internal/ListCatalog.sys.mjs",
    "internal/ListPreprocessor.sys.mjs",
    "internal/ListStore.sys.mjs",
    "internal/ListUpdates.sys.mjs",
    "internal/RemoteResources.sys.mjs",
    "internal/Resources.sys.mjs",
    "internal/SiteExceptions.sys.mjs",
]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

XPCSHELL_TESTS_MANIFESTS += ["test/unit/xpcshell.toml"]

FINAL_LIBRARY = "xul"
