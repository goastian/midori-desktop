+<!-- Midori Memory Profile -->
+<groupbox id="memoryProfileGroup" data-category="paneGeneral" hidden="true">
+  <label><html:h2 data-l10n-id="performance-memory-profile-title"/></label>
+
+  <hbox id="memoryProfileBox" align="center">
