diff --git a/browser/components/preferences/main.inc.xhtml b/browser/components/preferences/main.inc.xhtml
index f23beeb5c793bc7a6cbea4512a5f2cd379ec98c7..120a521bd3c4e20672058ef462467e7b256cd533 100644
--- a/browser/components/preferences/main.inc.xhtml
+++ b/browser/components/preferences/main.inc.xhtml
@@ -369,6 +369,27 @@
 <!-- Performance -->
 <html:setting-group groupid="performance" data-category="paneGeneral" hidden="true" />
 
+<!-- Midori Memory Profile -->
+<groupbox id="memoryProfileGroup" data-category="paneGeneral" hidden="true">
+  <label><html:h2 data-l10n-id="performance-memory-profile-title"/></label>
+
+  <hbox id="memoryProfileBox" align="center">
+    <label id="memoryProfileLabel"
+           control="memoryProfileMenulist"
+           data-l10n-id="performance-memory-profile-label"
+           flex="1"/>
+    <menulist id="memoryProfileMenulist" preference="midori.memory.profile" sizetopopup="always">
+      <menupopup>
+        <menuitem value="0" label="Performance (Higher RAM, faster)"/>
+        <menuitem value="1" label="Balanced (Recommended)"/>
+        <menuitem value="2" label="Low Memory (Lower RAM, slower)"/>
+        <menuitem value="3" label="Gaming/AI (WebGPU, Maximum Performance)"/>
+      </menupopup>
+    </menulist>
+  </hbox>
+  <description class="description-deemphasized" data-l10n-id="performance-memory-profile-desc"/>
+</groupbox>
+
 <!-- Browsing -->
 <html:setting-group groupid="browsing" data-category="paneGeneral" hidden="true"/>
 
