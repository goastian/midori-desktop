     initSettingGroup("profiles");
     initSettingGroup("profilePane");
 
+    // Midori Memory Profile handler
+    let memoryMenulist = document.getElementById("memoryProfileMenulist");
+    if (memoryMenulist) {
+      memoryMenulist.addEventListener("command", function () {
+        let profileIndex = parseInt(memoryMenulist.value, 10);
+        try {
+          MemoryProfileManager.applyProfile(profileIndex);
+          console.log("MemoryProfileManager: Profile changed to " + profileIndex);
+        } catch (e) {
+          console.error("MemoryProfileManager: Failed to apply profile", e);
+        }
+      });
+    }
+
     setEventListener("manageBrowserLanguagesButton", "command", function () {
