diff --git a/browser/components/preferences/main.inc.xhtml b/browser/components/preferences/main.inc.xhtml
index f6badc31b612c9198c56bb06751e9bbc4a0dd54b..f7b8f7f8b616b231a80322ec93879b1024a5548c 100644
--- a/browser/components/preferences/main.inc.xhtml
+++ b/browser/components/preferences/main.inc.xhtml
@@ -21,6 +21,18 @@
   <html:h1 data-l10n-id="pane-general-title"/>
 </hbox>
 
+<!-- Midori Center Banner -->
+<groupbox id="midoriCenterBanner" data-category="paneGeneral" hidden="true">
+  <hbox align="center" style="gap: 12px;">
+    <description flex="1" style="font-size: 13px;">
+      Personalize your browser — tab layout, sidebar, workspaces, and more — from Midori Center.
+    </description>
+    <button id="openMidoriCenter"
+            label="Open Midori Center"
+            style="background-color: #059669; color: white; border-radius: 8px; border: none; padding: 6px 16px; font-weight: 600; cursor: pointer;"/>
+  </hbox>
+</groupbox>
+
 <!-- Default browser -->
 <html:setting-group groupid="defaultBrowser" data-category="paneGeneral" hidden="true" />
 
@@ -191,6 +203,27 @@
 <!-- Performance -->
 <html:setting-group groupid="performance" data-category="paneGeneral" hidden="true" data-srd-migrated="" />
 
+<!-- Midori Memory Profile -->
+<groupbox id="memoryProfileGroup" data-category="paneGeneral" hidden="true">
+  <label><html:h2 data-l10n-id="performance-memory-profile-title"/></label>
+
+  <hbox id="memoryProfileBox" align="center">
+    <label id="memoryProfileLabel"
+           control="memoryProfileMenulist"
+           data-l10n-id="performance-memory-profile-label"
+           flex="1"/>
+    <menulist id="memoryProfileMenulist" preference="midori.memory.profile" sizetopopup="always">
+      <menupopup>
+        <menuitem value="0" label="Performance (Recommended, Firefox baseline)"/>
+        <menuitem value="1" label="Balanced (Lower RAM, may be slower)"/>
+        <menuitem value="2" label="Low Memory (Lower RAM, slower)"/>
+        <menuitem value="3" label="Gaming/AI (WebGPU, Maximum Performance)"/>
+      </menupopup>
+    </menulist>
+  </hbox>
+  <description class="description-deemphasized" data-l10n-id="performance-memory-profile-desc"/>
+</groupbox>
+
 <!-- Browsing -->
 <html:setting-group groupid="browsing" data-category="paneGeneral" hidden="true"/>
 
