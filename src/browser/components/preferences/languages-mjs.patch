+add_task(async function testFallbackUsesRequestedLocaleOrder() {
+  await SpecialPowers.pushPrefEnv({
+    set: [
+      ["intl.multilingual.enabled", true],
+      ["intl.multilingual.downloadEnabled", false],
+      ["intl.multilingual.liveReload", true],
+      ["intl.multilingual.liveReloadBidirectional", true],
+      ["intl.locale.requested", "zh-CN"],
+      ["extensions.langpacks.signatures.required", false],
+    ],
+  });
+
+  let addons = await installLangpacks(["zh-CN", "zh-TW", "de"]);
+  let doc = await openLanguagesPrefs();
+  let win = doc.defaultView;
+  await waitForLanguageUI(doc);
+
+  await changeLocale(doc, "zh-TW");
+  await BrowserTestUtils.waitForCondition(
+    () => Services.locale.requestedLocales[0] === "zh-TW",
+    "Traditional Chinese is live-applied"
+  );
+
+  let fallbackControl = getSettingControl("browserLanguageFallback", win);
+  await waitForSettingVisible("browserLanguageFallback", win);
+  is(fallbackControl.controlEl.value, "zh-CN", "Previous locale is fallback");
+
+  await changeMozSelectValue(fallbackControl.controlEl, "de");
+  await BrowserTestUtils.waitForCondition(
+    () => fallbackControl.controlEl.value === "de",
+    "Requested fallback remains selected"
+  );
+  Assert.deepEqual(
+    Services.locale.requestedLocales,
+    ["zh-TW", "de"],
+    "Fallback order matches the explicit user selection"
+  );
+
+  await Promise.all(addons.map(addon => addon.uninstall()));
+  BrowserTestUtils.removeTab(gBrowser.selectedTab);
+});
+
