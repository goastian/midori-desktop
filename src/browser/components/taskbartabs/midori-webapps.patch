+add_task(async function test_system_integration_concurrency_is_bounded() {
+  gPinStub.resetBehavior();
+  let active = 0;
+  let maximumActive = 0;
+  const releases = [];
+  gPinStub.callsFake(async () => {
+    active++;
+    maximumActive = Math.max(maximumActive, active);
+    await new Promise(resolve => releases.push(resolve));
+    active--;
+    return { ok: true, shortcutRelativePath: SHORTCUT_RELATIVE_PATH };
+  });
+
+  const installs = Array.from({ length: 8 }, (_, index) =>
+    TaskbarTabs.findOrCreateTaskbarTab(
+      Services.io.newURI(`https://concurrency-${index}.example.com/`),
+      0,
+      { awaitSystemIntegration: true, notify: false }
+    )
+  );
+
+  await TestUtils.waitForCondition(
+    () => releases.length === 4,
+    "The first four system integrations started"
+  );
+  releases.splice(0).forEach(release => release());
+  await TestUtils.waitForCondition(
+    () => releases.length === 4,
+    "The queued system integrations received reserved permits"
+  );
+  releases.splice(0).forEach(release => release());
+
+  const results = await Promise.all(installs);
+  is(maximumActive, 4, "At most four system integrations run concurrently");
+
+  restorePinBehavior();
+  for (const { taskbarTab: installedTaskbarTab } of results) {
+    await TaskbarTabs.removeTaskbarTab(installedTaskbarTab.id);
+  }
+});
