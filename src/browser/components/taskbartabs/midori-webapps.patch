+add_task(async function test_rename_persistence_failure_restores_shortcut() {
+  const uri = Services.io.newURI("https://rename-persistence.example.com/");
+  const { taskbarTab } = await TaskbarTabs.findOrCreateTaskbarTab(uri, 0, {
+    manifest: { name: "Original" },
+    awaitSystemIntegration: true,
+    notify: false,
+  });
+  const sandbox = sinon.createSandbox();
+  const persistenceError = new Error("simulated persistence failure");
+  const flushStub = sandbox.stub(TaskbarTabsRegistryStorage.prototype, "flush");
+  flushStub.resolves();
+  flushStub.onSecondCall().rejects(persistenceError);
+  const saveStub = sandbox.stub(TaskbarTabsRegistryStorage.prototype, "save");
+  saveStub.resolves();
+  saveStub.onCall(3).rejects(persistenceError);
+
+  const pinnedNames = [];
+  gPinStub.resetHistory();
+  gPinStub.resetBehavior();
+  gPinStub.callsFake(currentTaskbarTab => {
+    pinnedNames.push(currentTaskbarTab.name);
+    return {
+      ok: true,
+      shortcutRelativePath: `${currentTaskbarTab.name}.lnk`,
+    };
+  });
+  gUnpinStub.resetHistory();
+  restoreUnpinBehavior();
+
+  const notifications = [];
+  const observer = (_subject, _topic, data) => {
+    notifications.push({
+      change: JSON.parse(data),
+      name: taskbarTab.name,
+      shortcutRelativePath: taskbarTab.shortcutRelativePath,
+    });
+  };
+  Services.obs.addObserver(observer, "midori-webapps-changed");
+
+  try {
+    await Assert.rejects(
+      TaskbarTabs.renameTaskbarTab(taskbarTab.id, "Renamed"),
+      /simulated persistence failure/,
+      "The persistence failure reaches the caller"
+    );
+  } finally {
+    Services.obs.removeObserver(observer, "midori-webapps-changed");
+    sandbox.restore();
+  }
+
+  Assert.deepEqual(
+    pinnedNames,
+    ["Renamed", "Original"],
+    "The rollback recreates the shortcut with its original name"
+  );
+  Assert.equal(
+    gUnpinStub.callCount,
+    2,
+    "Both old and new shortcuts were removed"
+  );
+  Assert.equal(taskbarTab.name, "Original", "The original name was restored");
+  Assert.equal(
+    taskbarTab.shortcutRelativePath,
+    "Original.lnk",
+    "The original shortcut was recreated"
+  );
+  Assert.deepEqual(
+    notifications.at(-1),
+    {
+      change: {
+        version: 1,
+        type: "rename-rolled-back",
+        id: taskbarTab.id,
+      },
+      name: "Original",
+      shortcutRelativePath: "Original.lnk",
+    },
+    "Rollback notification is emitted after the shortcut is restored"
+  );
+
+  restorePinBehavior();
+  restoreUnpinBehavior();
+  await TaskbarTabs.removeTaskbarTab(taskbarTab.id);
+});
