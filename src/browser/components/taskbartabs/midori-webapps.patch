+function isInstallableTaskbarTabURL(aUrl) {
+  if (!(aUrl instanceof Ci.nsIURL) || aUrl.userPass) {
+    return false;
+  }
+  if (aUrl.scheme === "https") {
+    return true;
+  }
+  return (
+    aUrl.scheme === "http" &&
+    ["localhost", "127.0.0.1", "::1"].includes(aUrl.host)
+  );
