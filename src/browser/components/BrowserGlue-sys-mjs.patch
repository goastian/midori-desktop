   },
 
   async _maybeShowDefaultBrowserPrompt() {
+    // =========================================================================
+    // Midori browser welcome
+
+    const welcomeEnabledPref = 'midori.welcome.enabled'
+    const welcomeSeenPref = 'midori.welcome.seen'
+
+    // NOTE: Get bool prefs takes in two options, the pref string and a default
+    // value if it is not defined
+
+    const welcomeEnabled = Services.prefs.getBoolPref(welcomeEnabledPref, true)
+    const welcomeSeen = Services.prefs.getBoolPref(welcomeSeenPref, false)
+
+    if (welcomeEnabled && !welcomeSeen)
+      this._showWelcomeDialog()
+
+    // =========================================================================
+    // Midori Memory Profile - Initialize and apply on startup
+    try {
+      lazy.MemoryProfileManager.init();
+      lazy.MemoryProfileManager.applyProfile(
+        lazy.MemoryProfileManager.getCurrentProfile()
+      );
+    } catch (e) {
+      console.error("Midori: Failed to initialize MemoryProfileManager", e);
+    }
+    // =========================================================================
+
     // Ensuring the user is notified arranges the following ordering.  Highest
     // priority is datareporting policy modal, if present.  Second highest
     // priority is the upgrade dialog, which can include a "primary browser"
@@ -1781,4 +1809,17 @@ BrowserGlue.prototype = {
     "nsIObserver",
     "nsISupportsWeakReference",
   ]),
+
+  /**
+  * Displays the welcome dialog.
+  *
+  * @todo Add gluon docs for how to show custom popups on startup
+  * @patch Midori Browser
+  */
+  _showWelcomeDialog() {
+    lazy.BrowserWindowTracker.getTopWindow().gDialogBox.open(
