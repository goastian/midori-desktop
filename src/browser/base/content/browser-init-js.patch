diff --git a/browser/base/content/browser-init.js b/browser/base/content/browser-init.js
index 0aa4baea8e5e6d742fc6cd3333068e7eb64b5bbc..3fe44d531439ca365900647f86e43cd74980c284 100644
--- a/browser/base/content/browser-init.js
+++ b/browser/base/content/browser-init.js
@@ -572,6 +572,40 @@ var gBrowserInit = {
     gProtectionsHandler.init();
     gTrustPanelHandler.init();
 
+    // Midori: keep the built-in Midori Privacy browser action at the start of
+    // the URL bar. The Rust/WASM rewrite can register its browser-action later
+    // than the old extension, so use an observer instead of a short retry loop.
+    {
+      const widgetId = "midori-protection_astian_org-browser-action";
+      const moveWidget = () => {
+        const widget = document.getElementById(widgetId);
+        const urlbarContainer = document.querySelector(".urlbar-input-container");
+        if (!widget || !urlbarContainer) {
+          return false;
+        }
+
+        widget.querySelector(".toolbarbutton-text")?.setAttribute("hidden", "true");
+        widget.setAttribute("cui-areatype", "toolbar");
+        widget.setAttribute("midori-urlbar-action", "privacy");
+        if (widget.parentElement !== urlbarContainer || widget.previousElementSibling) {
+          urlbarContainer.prepend(widget);
+        }
+        return true;
+      };
+
+      if (!moveWidget()) {
+        const navTarget = document.getElementById("nav-bar-customization-target");
+        const observerRoot = navTarget || document.getElementById("navigator-toolbox") || document;
+        const observer = new MutationObserver(() => {
+          if (moveWidget()) {
+            observer.disconnect();
+          }
+        });
+        observer.observe(observerRoot, { childList: true, subtree: true });
+        setTimeout(() => observer.disconnect(), 30000);
+      }
+    }
+
     let safeMode = document.getElementById("helpSafeMode");
     if (Services.appinfo.inSafeMode) {
       document.l10n.setAttributes(safeMode, "menu-help-exit-troubleshoot-mode");
