+#if defined(__Userspace__)
+static uint32_t (*sctp_receive_window_limit)(uint32_t);
+static int (*sctp_receive_window_may_grow_callback)(void);
+
+/* Configure before initializing the stack and starting its threads. */
+void
+sctp_set_receive_window_callback(uint32_t (*receive_window_limit)(uint32_t),
+                                 int (*receive_window_may_grow)(void))
+{
+	sctp_receive_window_limit = receive_window_limit;
+	sctp_receive_window_may_grow_callback = receive_window_may_grow;
+}
+#endif
+
+uint32_t
+sctp_limit_advertised_rwnd(uint32_t available, uint32_t rtt_ms, uint32_t fragment_size)
+{
+#if defined(__Userspace__)
+	if (sctp_receive_window_limit != NULL) {
+		uint32_t limit = sctp_receive_window_limit(rtt_ms);
+		uint64_t chunks, credit;
+
+		if (limit == UINT32_MAX) {
+			return (available);
+		}
+		if (fragment_size == 0) {
+			fragment_size = 1200;
+		}
+		chunks = ((uint64_t)limit + fragment_size - 1) / fragment_size;
+		credit = limit + chunks * SCTP_BASE_SYSCTL(sctp_peer_chunk_oh);
+		return (credit < available ? (uint32_t)credit : available);
+	}
+#endif
+	return (available);
+}
+
+int
+sctp_receive_window_is_limited(void)
+{
+#if defined(__Userspace__)
+	return (sctp_receive_window_limit != NULL &&
+	        sctp_receive_window_limit(0) < UINT32_MAX);
+#else
+	return (0);
+#endif
+}
+
+int
+sctp_receive_window_may_grow(void)
+{
+#if defined(__Userspace__)
+	return (sctp_receive_window_may_grow_callback != NULL &&
+	        sctp_receive_window_may_grow_callback());
+#else
+	return (0);
+#endif
+}
