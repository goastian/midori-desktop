+static void
+sctp_probe_receive_window_rtt(struct sctp_tcb *stcb, int so_locked)
+{
+	struct sctp_association *asoc = &stcb->asoc;
+	struct sctp_nets *net = asoc->primary_destination;
+	struct timeval now;
+	uint64_t now_ms;
+	uint8_t responded;
+
+	if (!sctp_receive_window_is_limited() || net == NULL ||
+	    (net->dest_state & SCTP_ADDR_UNCONFIRMED)) {
+		return;
+	}
+	(void)SCTP_GETTIME_TIMEVAL(&now);
+	now_ms = (uint64_t)now.tv_sec * 1000 + now.tv_usec / 1000;
+	if (now_ms < asoc->receive_window_probe_ms ||
+	    now_ms - asoc->receive_window_probe_ms < 1000) {
+		return;
+	}
+	asoc->receive_window_probe_ms = now_ms;
+	responded = net->hb_responded;
+	sctp_send_hb(stcb, net, so_locked);
+	net->hb_responded = responded;
+}
