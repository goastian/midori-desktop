+mozilla::ipc::IPCResult SocketProcessChild::RecvGetMidoriSocketUsage(
+    GetMidoriSocketUsageResolver&& aResolve) {
+  if (!gSocketTransportService) {
+    aResolve(MidoriSocketUsage(false, 0, 0, 0, 0, 0, 0));
+    return IPC_OK();
+  }
+  RefPtr<nsSocketTransportService> service = gSocketTransportService;
+  using Resolver =
+      DataResolver<MidoriSocketUsage, GetMidoriSocketUsageResolver>;
+  RefPtr<Resolver> resolver = new Resolver(std::move(aResolve));
+  const nsresult rv = service->Dispatch(
+      NS_NewRunnableFunction(
+          "SocketProcessChild::RecvGetMidoriSocketUsage",
+          [resolver, service]() {
+            uint64_t sent, received;
+            service->GetManagedSocketByteCounts(sent, received);
+            const auto state = MidoriNetworkBudget::GetBudgetState();
+            resolver->OnResolve(MidoriSocketUsage(
+                true, sent, received, state.downloadBps, state.uploadBps,
+                state.downloadGeneration, state.uploadGeneration));
+          }),
+      NS_DISPATCH_NORMAL);
+  if (NS_FAILED(rv)) {
+    resolver->OnResolve(MidoriSocketUsage(false, 0, 0, 0, 0, 0, 0));
+  }
+  return IPC_OK();
+}
