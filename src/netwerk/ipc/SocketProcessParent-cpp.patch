+mozilla::ipc::IPCResult SocketProcessParent::RecvRequestMidoriNetworkQuota(
+    const bool& aUpload, const uint32_t& aRequested, const uint32_t& aFlows,
+    RequestMidoriNetworkQuotaResolver&& aResolve) {
+  const auto grant = MidoriNetworkBudget::GrantToSocketProcess(
+      aUpload ? MidoriNetworkBudget::Direction::Upload
+              : MidoriNetworkBudget::Direction::Download,
+      aRequested, aFlows);
+  aResolve(MidoriNetworkGrant(grant.bytes, grant.rate));
+  return IPC_OK();
+}
