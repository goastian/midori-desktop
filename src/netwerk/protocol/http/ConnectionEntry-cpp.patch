+void ConnectionEntry::UpdateMidoriReceiveBuffers(uint32_t aDownloadBps) {
+  MOZ_ASSERT(OnSocketThread());
+  const auto update = [aDownloadBps](const auto& connections) {
+    for (const auto& connection : connections) {
+      RefPtr<HttpConnectionUDP> udp = do_QueryObject(connection);
+      if (udp) {
+        (void)udp->UpdateMidoriReceiveBuffer(aDownloadBps);
+      }
+    }
+  };
+  update(mActiveConns);
+  update(mPendingConns);
+  update(mExtendedCONNECTConns);
+}
