+uint32_t Http2StreamBase::UpdateClientReceiveWindow(uint32_t aTarget,
+                                                    uint32_t aMaximumAck) {
+  const uint32_t target = std::min(aTarget, 0x7fffffffU);
+  const uint64_t capacity = mClientReceiveWindow + int64_t(mLocalUnacked);
+  const uint32_t growth = capacity < target ? target - capacity : 0;
+  uint32_t ack =
+      mClientReceiveWindow < target
+          ? std::min<uint64_t>(aMaximumAck, target - mClientReceiveWindow)
+          : 0;
+  ack = std::min(ack, 0x7fffffffU - growth);
+  mClientReceiveWindow += growth;
+  IncrementClientReceiveWindow(ack);
+  return growth + ack;
+}
