+nsresult HttpConnectionUDP::UpdateMidoriReceiveBuffer(uint32_t aDownloadBps) {
+  MOZ_ASSERT(OnSocketThread());
+  if (!mSocket || mSocket->IsSocketClosed()) return NS_ERROR_NOT_AVAILABLE;
+  const uint32_t configured = StaticPrefs::network_http_http3_recvBufferSize();
+  const uint32_t requested =
+      aDownloadBps
+          ? std::min(configured, std::max(128u * 1024, aDownloadBps / 2))
+          : configured;
+  const nsresult rv = mSocket->SetRecvBufferSize(requested);
+  MOZ_LOG(sMidoriHttp3ReceiveResourceLog, LogLevel::Debug,
+          ("receive-capacity connection=%p rate=%u requested=%u rv=%" PRIx32,
+           this, aDownloadBps, requested, static_cast<uint32_t>(rv)));
+  return rv;
+}
