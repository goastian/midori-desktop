From bd938264b826005b7864c68d05bab1535efe5158 Mon Sep 17 00:00:00 2001
From: Alfonso Hernandez <alfonso.hernandez@astian.org>
Date: Sun, 23 Nov 2025 22:07:59 -0500
Subject: [PATCH] remove user agent default and implement compat for more
 privacy

---
 netwerk/protocol/http/nsHttpHandler.cpp | 24 +++++++++++-------------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/netwerk/protocol/http/nsHttpHandler.cpp b/netwerk/protocol/http/nsHttpHandler.cpp
index 23e5ba4a9f..d2e2bfb160 100644
--- a/netwerk/protocol/http/nsHttpHandler.cpp
+++ b/netwerk/protocol/http/nsHttpHandler.cpp
@@ -1040,19 +1040,17 @@ void nsHttpHandler::BuildUserAgent() {
   mUserAgent += '/';
   mUserAgent += mProductSub;
 
-  bool isFirefox = mAppName.EqualsLiteral("Firefox");
-  if (isFirefox || mCompatFirefoxEnabled) {
-    // "Firefox/x.y" (compatibility) app token
-    mUserAgent += ' ';
-    mUserAgent += mCompatFirefox;
-  }
-  if (!isFirefox) {
-    // App portion
-    mUserAgent += ' ';
-    mUserAgent += mAppName;
-    mUserAgent += '/';
-    mUserAgent += mAppVersion;
-  }
+  // By removing the isFirefox variable here, we gain the Firefox user agent,
+  // which reduces the fingerprinting footprint and makes the browser function
+  // correctly on mozilla sites like addons.mozilla.org. It also provides an
+  // insignificant performance boost because we are removing a branching section
+  //
+  // TODO: Should be able to use mCompatFirefoxEnabled insead of this patch,
+  // which will reduce code complexity.
+
+  // "Firefox/x.y" (compatibility) app token
+  mUserAgent += ' ';
+  mUserAgent += mCompatFirefox;
 }
 
 #ifdef XP_WIN
