+
+bool nsUDPOutputStream::NotifyReady(bool aRetry) {
+  MOZ_ASSERT(OnSocketThread());
+  if (!mCallback) return false;
+  if (NS_SUCCEEDED(StreamStatus()) &&
+      (!WaitingForOutput() || (mRetryPending && !aRetry) ||
+       MidoriNetworkBudget::WaitMilliseconds(
+           MidoriNetworkBudget::Direction::Upload, true,
+           static_cast<nsIUDPSocket*>(mSocket.get())))) {
+    return true;
+  }
+  nsCOMPtr<nsIOutputStreamCallback> callback = std::move(mCallback);
+  mRetryPending = false;
+  callback->OnOutputStreamReady(this);
+  return false;
+}
+
+NS_IMETHODIMP nsUDPOutputStream::AsyncWait(nsIOutputStreamCallback* aCallback,
+                                           uint32_t aFlags,
+                                           uint32_t aRequestedCount,
+                                           nsIEventTarget* aEventTarget) {
+  nsCOMPtr<nsIOutputStreamCallback> callback;
+  if (aCallback) {
+    callback = NS_NewOutputStreamReadyEvent(
+        aCallback, aEventTarget ? aEventTarget : mSocket->mSts.get());
+  }
+  if (!OnSocketThread()) {
+    return mSocket->mSts->Dispatch(
+        NS_NewRunnableFunction(
+            "nsUDPOutputStream::AsyncWait",
+            [self = RefPtr{this}, callback = std::move(callback), aFlags]() {
+              self->AsyncWait(callback, aFlags, 0, nullptr);
+            }),
+        NS_DISPATCH_NORMAL);
+  }
+  mSocket->RemoveOutputStreamWaiter(this);
+  mCallback = std::move(callback);
+  mCallbackFlags = aFlags;
+  if (NotifyReady(false)) mSocket->AddOutputStreamWaiter(this);
+  return NS_OK;
+}
+
+void nsUDPSocket::AddOutputStreamWaiter(nsUDPOutputStream* aStream) {
+  MOZ_ASSERT(OnSocketThread());
+  mOutputStreamWaiters.AppendElement(aStream);
+  if (aStream->WaitingForOutput()) ScheduleOutputStreams();
+}
+
+void nsUDPSocket::RemoveOutputStreamWaiter(nsUDPOutputStream* aStream) {
+  MOZ_ASSERT(OnSocketThread());
+  mOutputStreamWaiters.RemoveElementsBy(
+      [&](const auto& weak) { return weak.IsDead() || weak == aStream; });
+}
+
+void nsUDPSocket::ScheduleOutputStreams() {
+  MOZ_ASSERT(OnSocketThread());
+  if (mStreamWakePending) return;
+  mStreamWakePending = true;
+  nsresult rv = NS_DelayedDispatchToCurrentThread(
+      NS_NewRunnableFunction("nsUDPSocket::WakeOutputStreams",
+                             [self = RefPtr{this}]() {
+                               self->mStreamWakePending = false;
+                               self->WakeOutputStreams();
+                             }),
+      std::max(10U, MidoriNetworkBudget::WaitMilliseconds(
+                        MidoriNetworkBudget::Direction::Upload, true,
+                        static_cast<nsIUDPSocket*>(this))));
+  if (NS_FAILED(rv)) {
+    mStreamWakePending = false;
+    mCondition = rv;
+    if (!mAttached) OnSocketDetached(mFD);
+  }
+}
+
+void nsUDPSocket::WakeOutputStreams() {
+  MOZ_ASSERT(OnSocketThread());
+  auto waiters = std::move(mOutputStreamWaiters);
+  bool pending = false;
+  for (const auto& weak : waiters) {
+    RefPtr<nsUDPOutputStream> stream(weak);
+    if (!stream) continue;
+    if (NS_FAILED(mCondition))
+      stream->CloseWithStatus(mCondition);
+    else if (stream->NotifyReady(true)) {
+      mOutputStreamWaiters.AppendElement(weak);
+      pending |= stream->WaitingForOutput();
+    }
+  }
+  if (pending) ScheduleOutputStreams();
 }
 
