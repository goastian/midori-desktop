+bool nsUDPSocket::WaitForResourceQuota(bool aInput, bool aNewInput) {
+  MOZ_ASSERT(OnSocketThread());
+  if (!mFD || NS_FAILED(mCondition) || (!aInput && !mSyncListener))
+    return false;
+  if (aInput && MidoriNetworkBudget::DownloadRate()) {
+    PRPollDesc pendingRead{mFD, PR_POLL_READ, 0};
+    if (PR_Poll(&pendingRead, 1, PR_INTERVAL_NO_WAIT) <= 0 ||
+        !(pendingRead.out_flags & PR_POLL_READ)) {
+      MidoriNetworkBudget::CancelDatagramDemand(
+          MidoriNetworkBudget::Direction::Download,
+          static_cast<nsIUDPSocket*>(this));
+    }
+  }
+  const uint32_t delay = MidoriNetworkBudget::WaitMilliseconds(
+      aInput ? MidoriNetworkBudget::Direction::Download
+             : MidoriNetworkBudget::Direction::Upload,
+      true, static_cast<nsIUDPSocket*>(this));
+  if (!delay) return false;
+  if (aInput && aNewInput) EnsureReceiveHeadroom();
+  bool& pending = aInput ? mInputQuotaPending : mOutputQuotaPending;
+  if (!pending) {
+    pending = true;
+    const nsresult rv = NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction(
+            "nsUDPSocket::ResourceQuota",
+            [self = RefPtr{this}, aInput]() {
+              bool& waiting =
+                  aInput ? self->mInputQuotaPending : self->mOutputQuotaPending;
+              waiting = false;
+              if (!self->mFD || NS_FAILED(self->mCondition) ||
+                  (!aInput && !self->mSyncListener))
+                return;
+              if (!self->WaitForResourceQuota(aInput)) {
+                self->mPollFlags |=
+                    (aInput ? PR_POLL_READ : PR_POLL_WRITE) | PR_POLL_EXCEPT;
+              }
+            }),
+        delay);
+    if (NS_FAILED(rv)) {
+      pending = false;
+      return false;
+    }
+  }
+  mPollFlags &= ~(aInput ? PR_POLL_READ : PR_POLL_WRITE);
+  if (mPollFlags == PR_POLL_EXCEPT) mPollFlags = 0;
+  return true;
+}
