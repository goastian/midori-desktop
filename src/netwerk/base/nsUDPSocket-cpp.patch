 static const uint32_t UDP_PACKET_CHUNK_SIZE = 1400;
+static const uint32_t UDP_QUEUED_SOCKET_LIMIT = 1024 * 1024;
+static const uint32_t UDP_QUEUED_PACKET_OVERHEAD = 256;
+
+UDPDatagramReservation::UDPDatagramReservation(nsUDPSocket* aSocket,
+                                               uint32_t aBytes)
+    : mSocket(aSocket), mBytes(aBytes) {}
+
+UDPDatagramReservation::~UDPDatagramReservation() {
+  mSocket->ReleaseQueuedOutput(mBytes);
+  mCompletion.RejectIfExists(NS_BASE_STREAM_CLOSED, __func__);
+}
+
+RefPtr<DatagramSendPromise> UDPDatagramReservation::Completion() {
+  return mCompletion.Ensure(__func__);
+}
+
+void UDPDatagramReservation::Complete(nsresult aResult,
+                                      const TimeStamp& aSentAt) {
+  if (NS_FAILED(aResult))
+    mCompletion.RejectIfExists(aResult, __func__);
+  else
+    mCompletion.ResolveIfExists(aSentAt, __func__);
+}
+
+nsresult nsUDPSocket::ReserveQueuedOutput(
+    uint32_t aLength, RefPtr<UDPDatagramReservation>& aReservation) {
+  if (aLength > UINT16_MAX) return NS_ERROR_ILLEGAL_VALUE;
+  const uint32_t bytes = aLength + UDP_QUEUED_PACKET_OVERHEAD;
+  {
+    MutexAutoLock lock(mLock);
+    if (mQueuedOutputBytes > UDP_QUEUED_SOCKET_LIMIT - bytes) {
+      return NS_BASE_STREAM_WOULD_BLOCK;
+    }
+    if (!MidoriNetworkBudget::ReserveDatagramBytes(bytes)) {
+      return NS_BASE_STREAM_WOULD_BLOCK;
+    }
+    mQueuedOutputBytes += bytes;
+  }
+  aReservation = new UDPDatagramReservation(this, bytes);
+  return NS_OK;
+}
+
+void nsUDPSocket::ReleaseQueuedOutput(uint32_t aBytes) {
+  MutexAutoLock lock(mLock);
+  MOZ_ASSERT(mQueuedOutputBytes >= aBytes);
+  mQueuedOutputBytes -= aBytes;
+  MidoriNetworkBudget::ReleaseDatagramBytes(aBytes);
+}
+
+nsresult AsyncListenWithoutReplyStream(nsIUDPSocket* aSocket,
+                                       nsIUDPSocketListener* aListener) {
+  NS_ENSURE_ARG(aSocket);
+  NS_ENSURE_ARG(aListener);
+  nsCOMPtr<nsUDPSocket> socket = do_QueryObject(aSocket);
+  return socket ? socket->AsyncListenWithoutReplyStream(aListener)
+                : aSocket->AsyncListen(aListener);
+}
+
+RefPtr<DatagramSendPromise> SendDatagramWithCompletion(
+    nsIUDPSocket* aSocket, const NetAddr& aAddress,
+    const nsTArray<uint8_t>& aData, DatagramSendOptions aOptions) {
+  nsCOMPtr<nsUDPSocket> socket = do_QueryObject(aSocket);
+  if (!socket) {
+    return DatagramSendPromise::CreateAndReject(NS_ERROR_NOT_IMPLEMENTED,
+                                                __func__);
+  }
+  return socket->SendWithCompletion(aAddress, aData, aOptions);
+}
+
+RefPtr<DatagramSendPromise> nsUDPSocket::SendWithCompletion(
+    const NetAddr& aAddress, const nsTArray<uint8_t>& aData, DatagramSendOptions aOptions) {
+  RefPtr<UDPDatagramReservation> reservation;
+  nsresult rv = ReserveQueuedOutput(aData.Length(), reservation);
+  if (NS_FAILED(rv)) return DatagramSendPromise::CreateAndReject(rv, __func__);
+  FallibleTArray<uint8_t> data;
+  if (!data.AppendElements(aData.Elements(), aData.Length(), fallible)) {
+    return DatagramSendPromise::CreateAndReject(NS_ERROR_OUT_OF_MEMORY,
+                                                __func__);
+  }
+  RefPtr<DatagramSendPromise> completion = reservation->Completion();
+  QueueDatagram(aAddress, std::move(data), std::move(reservation), aOptions);
+  return completion;
+}
+
+nsresult nsUDPSocket::QueueDatagram(
+    const NetAddr& aAddr, FallibleTArray<uint8_t>&& aData,
+    RefPtr<UDPDatagramReservation> aReservation, DatagramSendOptions aOptions) {
+  MOZ_ASSERT(aReservation);
+  if (!OnSocketThread()) {
+    RefPtr<UDPDatagramReservation> reservation = aReservation;
+    nsresult rv = mSts->Dispatch(
+        NS_NewRunnableFunction("nsUDPSocket::QueueDatagram",
+                               [self = RefPtr{this}, addr = aAddr,
+                                reservation = std::move(aReservation),
+                                data = std::move(aData), aOptions]() mutable {
+                                 self->QueueDatagram(addr, std::move(data),
+                                                     std::move(reservation), aOptions);
+                               }),
+        NS_DISPATCH_NORMAL);
+    if (NS_FAILED(rv)) reservation->Complete(rv);
+    return rv;
+  }
+  if (!mFD || NS_FAILED(mCondition)) {
+    aReservation->Complete(NS_BASE_STREAM_CLOSED);
+    return NS_BASE_STREAM_CLOSED;
+  }
+  ExpireQueuedMedia();
+  if (!aOptions.expires.IsNull() &&
+      (mNextMediaExpiry.IsNull() || aOptions.expires < mNextMediaExpiry)) {
+    mNextMediaExpiry = aOptions.expires;
+  }
+  QueuedDatagram packet{aAddr, std::move(aReservation), aOptions, std::move(aData)};
+  if (aOptions.urgent) {
+    const auto position = std::find_if(
+        mQueuedDatagrams.begin(), mQueuedDatagrams.end(),
+        [](const QueuedDatagram& aPacket) { return !aPacket.mOptions.urgent; });
+    mQueuedDatagrams.insert(position, std::move(packet));
+  } else {
+    mQueuedDatagrams.push_back(std::move(packet));
+  }
+  FlushQueuedOutput();
+  return mCondition;
+}
+
+void nsUDPSocket::ExpireQueuedMedia() {
+  if (mNextMediaExpiry.IsNull()) return;
+  const TimeStamp now = TimeStamp::Now();
+  if (mNextMediaExpiry > now) return;
+  mNextMediaExpiry = TimeStamp();
+  for (auto packet = mQueuedDatagrams.begin(); packet != mQueuedDatagrams.end();) {
+    if (packet->mOptions.expires.IsNull() || packet->mOptions.expires > now) {
+      if (!packet->mOptions.expires.IsNull() &&
+          (mNextMediaExpiry.IsNull() ||
+           packet->mOptions.expires < mNextMediaExpiry)) {
+        mNextMediaExpiry = packet->mOptions.expires;
+      }
+      ++packet;
+    } else {
+      auto reservation = std::move(packet->mReservation);
+      packet = mQueuedDatagrams.erase(packet);
+      reservation->Complete(NS_OK);
+    }
+  }
+  if (mQueuedDatagrams.empty() && mOutputStreamWaiters.IsEmpty()) {
+    MidoriNetworkBudget::CancelDatagramDemand(
+        MidoriNetworkBudget::Direction::Upload,
+        static_cast<nsIUDPSocket*>(this));
+  }
+}
+
+void nsUDPSocket::ClearQueuedOutput(nsresult aReason) {
+  mNextMediaExpiry = TimeStamp();
+  while (!mQueuedDatagrams.empty()) {
+    auto reservation = std::move(mQueuedDatagrams.front().mReservation);
+    mQueuedDatagrams.pop_front();
+    reservation->Complete(aReason);
+  }
+  if (mOutputStreamWaiters.IsEmpty()) {
+    MidoriNetworkBudget::CancelDatagramDemand(
+        MidoriNetworkBudget::Direction::Upload,
+        static_cast<nsIUDPSocket*>(this));
+  }
+}
+
+void nsUDPSocket::ScheduleQueuedOutput(uint32_t aDelay) {
+  MOZ_ASSERT(OnSocketThread());
+  if (mQueueWakePending || mQueuedDatagrams.empty()) return;
+  mQueueWakePending = true;
+  nsCOMPtr<nsIRunnable> event = NS_NewRunnableFunction(
+      "nsUDPSocket::FlushQueuedOutput", [self = RefPtr{this}]() {
+        self->mQueueWakePending = false;
+        self->FlushQueuedOutput();
+      });
+  nsresult rv = aDelay
+                    ? NS_DelayedDispatchToCurrentThread(event.forget(), aDelay)
+                    : NS_DispatchToCurrentThread(event.forget());
+  if (NS_FAILED(rv)) {
+    mQueueWakePending = false;
+    mCondition = rv;
+    ClearQueuedOutput(rv);
+    if (!mAttached) OnSocketDetached(mFD);
+  }
+}
+
+void nsUDPSocket::FlushQueuedOutput() {
+  MOZ_ASSERT(OnSocketThread());
+  if (!mFD || NS_FAILED(mCondition)) {
+    ClearQueuedOutput(NS_BASE_STREAM_CLOSED);
+    return;
+  }
+  ExpireQueuedMedia();
+  uint32_t sent = 0;
+  while (!mQueuedDatagrams.empty() && sent < 64) {
+    auto& packet = mQueuedDatagrams.front();
+    uint32_t written = 0;
+    TimeStamp sentAt;
+    nsresult rv = SendDatagramNow(&packet.mAddr, packet.mData.Elements(),
+                                  packet.mData.Length(), &written, &sentAt);
+    if (rv == NS_BASE_STREAM_WOULD_BLOCK) {
+      ScheduleQueuedOutput(
+          std::max(10U, MidoriNetworkBudget::WaitMilliseconds(
+                            MidoriNetworkBudget::Direction::Upload, true,
+                            static_cast<nsIUDPSocket*>(this))));
+      return;
+    }
+    if (NS_FAILED(rv)) {
+      mCondition = rv;
+      ClearQueuedOutput(rv);
+      if (!mAttached) OnSocketDetached(mFD);
+      return;
+    }
+    MOZ_ASSERT(written == packet.mData.Length());
+    auto reservation = std::move(packet.mReservation);
+    mQueuedDatagrams.pop_front();
+    reservation->Complete(NS_OK, sentAt);
+    ++sent;
+  }
+  if (!mQueuedDatagrams.empty()) {
+    ScheduleQueuedOutput(0);
+  } else if (mOutputStreamWaiters.IsEmpty()) {
+    MidoriNetworkBudget::CancelDatagramDemand(
+        MidoriNetworkBudget::Direction::Upload,
+        static_cast<nsIUDPSocket*>(this));
+  }
+}
 
