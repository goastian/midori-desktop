+bool nsSocketTransport::WaitForResourceQuota(bool aInput) {
+  const uint32_t delay = MidoriNetworkBudget::WaitMilliseconds(
+      aInput ? MidoriNetworkBudget::Direction::Download
+             : MidoriNetworkBudget::Direction::Upload, false, this);
+  if (!delay) return false;
+  bool& pending = aInput ? mInputQuotaPending : mOutputQuotaPending;
+  if (!pending) {
+    pending = true;
+    const nsresult rv = NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction("nsSocketTransport::ResourceQuota",
+                               [self = RefPtr{this}, aInput]() {
+                                 if (aInput) {
+                                   self->mInputQuotaPending = false;
+                                   self->OnMsgInputPending();
+                                 } else {
+                                   self->mOutputQuotaPending = false;
+                                   self->OnMsgOutputPending();
+                                 }
+                               }),
+        delay);
+    if (NS_FAILED(rv)) {
+      pending = false;
+      return false;
+    }
+  }
+  mPollFlags &= ~(aInput ? PR_POLL_READ : PR_POLL_WRITE);
+  if (mPollFlags == PR_POLL_EXCEPT) mPollFlags = 0;
+  return true;
+}
+
+void nsSocketTransport::OnMsgInputPending() {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  if (mState == STATE_TRANSFERRING && !WaitForResourceQuota(true)) {
+    mPollFlags |= (PR_POLL_READ | PR_POLL_EXCEPT);
+  }
+}
+
+void nsSocketTransport::OnMsgOutputPending() {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  if (mState == STATE_TRANSFERRING && !WaitForResourceQuota(false)) {
+    mPollFlags |= (PR_POLL_WRITE | PR_POLL_EXCEPT);
+  }
+}
 
