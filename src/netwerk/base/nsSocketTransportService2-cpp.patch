+void nsSocketTransportService::GetManagedSocketByteCounts(uint64_t& aSent,
+                                                          uint64_t& aReceived) {
+  MOZ_ASSERT(OnSocketThread(), "not on socket thread");
+  aSent = mSentBytesCount;
+  aReceived = mReceivedBytesCount;
+  for (const auto& context : mActiveList) {
+    aSent += context.mHandler->ByteCountSent();
+    aReceived += context.mHandler->ByteCountReceived();
+  }
+  for (const auto& context : mIdleList) {
+    aSent += context.mHandler->ByteCountSent();
+    aReceived += context.mHandler->ByteCountReceived();
+  }
+}
+
 bool nsSocketTransportService::IsTelemetryEnabledAndNotSleepPhase() {
   return Telemetry::CanRecordPrereleaseData() && !mSleepPhase;
 }
