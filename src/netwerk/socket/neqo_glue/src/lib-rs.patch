 std::thread_local! {
     static RECV_BUF: RefCell<neqo_udp::RecvBuf> = RefCell::new(neqo_udp::RecvBuf::default());
+    static QUOTA_RECV_BUF: RefCell<neqo_udp::RecvBuf> = RefCell::new(neqo_udp::RecvBuf::single());
+}
+
+extern "C" {
+    fn MidoriNetworkReserveDatagramForFlow(
+        upload: bool,
+        requested: u32,
+        generation: *mut u64,
+        process_share: *mut bool,
+        flow: *const c_void,
+    ) -> u32;
+    fn MidoriNetworkRefundDatagramForFlow(
+        upload: bool,
+        reserved: u32,
+        generation: u64,
+        process_share: bool,
+        used: u32,
+        flow: *const c_void,
+    );
+    fn MidoriNetworkCancelDatagramDemand(upload: bool, flow: *const c_void);
+}
+
+struct NetworkReservation {
+    upload: bool,
+    bytes: u32,
+    generation: u64,
+    process_share: bool,
+    used: u32,
+    flow: *const c_void,
+}
+
+impl NetworkReservation {
+    fn new(upload: bool, requested: u32, flow: *const c_void) -> Self {
+        let mut generation = 0;
+        let mut process_share = false;
+        let bytes = unsafe {
+            MidoriNetworkReserveDatagramForFlow(
+                upload,
+                requested,
+                &mut generation,
+                &mut process_share,
+                flow,
+            )
+        };
+        Self {
+            upload,
+            bytes,
+            generation,
+            process_share,
+            used: 0,
+            flow,
+        }
+    }
+}
+
+impl Drop for NetworkReservation {
+    fn drop(&mut self) {
+        if self.generation != 0 && self.bytes != 0 {
+            unsafe {
+                MidoriNetworkRefundDatagramForFlow(
+                    self.upload,
+                    self.bytes,
+                    self.generation,
+                    self.process_share,
+                    self.used,
+                    self.flow,
+                );
+            }
+        }
+    }
 }
 
