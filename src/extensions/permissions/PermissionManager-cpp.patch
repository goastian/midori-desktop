+bool MidoriSyncPermissionEntriesEqual(
+    const Maybe<mozilla::PermissionManager::PermissionEntry>& aLeft,
+    const Maybe<mozilla::PermissionManager::PermissionEntry>& aRight) {
+  if (!aLeft || !aRight) {
+    return !aLeft && !aRight;
+  }
+  return aLeft->mID == aRight->mID &&
+         aLeft->mPermission == aRight->mPermission &&
+         aLeft->mExpireType == aRight->mExpireType &&
+         aLeft->mExpireTime == aRight->mExpireTime &&
+         aLeft->mModificationTime == aRight->mModificationTime;
+}
+
+nsresult WriteMidoriSyncPermissionSnapshots(
+    mozIStorageConnection* aConnection, const nsACString& aOrigin,
+    const nsTArray<MidoriSyncPermissionSnapshot>& aSnapshots) {
+  nsresult rv = aConnection->BeginTransaction();
+  NS_ENSURE_SUCCESS(rv, rv);
+  auto rollback = MakeScopeExit([&] { aConnection->RollbackTransaction(); });
+  for (const auto& snapshot : aSnapshots) {
+    nsCOMPtr<mozIStorageStatement> remove;
+    rv = aConnection->CreateStatement(
+        "DELETE FROM moz_perms WHERE origin = :origin AND type = :type"_ns,
+        getter_AddRefs(remove));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = remove->BindUTF8StringByName(
+        "origin"_ns, snapshot.key ? snapshot.key->mOrigin : aOrigin);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = remove->BindUTF8StringByName("type"_ns, snapshot.type);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = remove->Execute();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  for (const auto& snapshot : aSnapshots) {
+    if (!snapshot.entry || snapshot.entry->mID == cIDPermissionIsDefault) {
+      continue;
+    }
+    const auto& entry = *snapshot.entry;
+    nsCOMPtr<mozIStorageStatement> insert;
+    rv = aConnection->CreateStatement(
+        "INSERT INTO moz_perms (id, origin, type, permission, expireType, "
+        "expireTime, modificationTime) "
+        "VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)"_ns,
+        getter_AddRefs(insert));
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindInt64ByIndex(0, entry.mID);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindUTF8StringByIndex(
+        1, snapshot.key ? snapshot.key->mOrigin : aOrigin);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindUTF8StringByIndex(2, snapshot.type);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindInt32ByIndex(3, entry.mPermission);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindInt32ByIndex(4, entry.mExpireType);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindInt64ByIndex(5, entry.mExpireTime);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->BindInt64ByIndex(6, entry.mModificationTime);
+    NS_ENSURE_SUCCESS(rv, rv);
+    rv = insert->Execute();
+    NS_ENSURE_SUCCESS(rv, rv);
+  }
+  rv = aConnection->CommitTransaction();
+  if (NS_SUCCEEDED(rv)) {
+    rollback.release();
+  }
+  return rv;
+}
