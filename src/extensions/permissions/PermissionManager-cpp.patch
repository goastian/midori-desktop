+NS_IMETHODIMP
+PermissionManager::PersistPermissionFromPrincipal(nsIPrincipal* aPrincipal,
+                                                  const nsACString& aType,
+                                                  JSContext* aCx,
+                                                  Promise** aPromise) {
+  ENSURE_NOT_CHILD_PROCESS;
+  MOZ_ASSERT(NS_IsMainThread());
+  NS_ENSURE_ARG_POINTER(aPrincipal);
+  if (aType.IsEmpty() || aPrincipal->IsSystemPrincipal() ||
+      IsExpandedPrincipal(aPrincipal) ||
+      BasePrincipal::Cast(aPrincipal)
+          ->OriginAttributesRef()
+          .mPrivateBrowsingId) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  nsIGlobalObject* global = xpc::CurrentNativeGlobal(aCx);
+  NS_ENSURE_TRUE(global, NS_ERROR_FAILURE);
+  ErrorResult error;
+  RefPtr<Promise> promise = Promise::Create(global, error);
+  if (error.Failed()) {
+    return error.StealNSResult();
+  }
+  nsresult rv;
+  RefPtr<PermissionKey> key = PermissionKey::CreateFromPrincipal(
+      aPrincipal, IsOAForceStripPermission(aType),
+      IsSiteScopedPermission(aType), rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+  if (!StringBeginsWith(key->mOrigin, "http://"_ns) &&
+      !StringBeginsWith(key->mOrigin, "https://"_ns)) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  nsTArray<MidoriSyncPermissionSnapshot> snapshots;
+  nsCOMPtr<nsIThread> thread;
+  {
+    MonitorAutoLock lock(mMonitor);
+    EnsureReadCompleted();
+    const auto expected = SnapshotSyncPermission(key, aType);
+    if (expected && expected->mExpireType != EXPIRE_NEVER &&
+        expected->mExpireType != EXPIRE_TIME) {
+      return NS_ERROR_NOT_AVAILABLE;
+    }
+    snapshots.AppendElement(
+        MidoriSyncPermissionSnapshot{nsCString(aType), expected});
+    const nsCString markerType = MidoriSyncOmissionType(aType);
+    if (!markerType.IsEmpty() && mThread) {
+      snapshots.AppendElement(MidoriSyncPermissionSnapshot{
+          markerType, SnapshotSyncPermission(key, markerType)});
+      nsCOMPtr<nsIPrincipal> trackingPrincipal;
+      rv = GetPrincipalFromOrigin(kMidoriSyncTrackingOrigin, false,
+                                  getter_AddRefs(trackingPrincipal));
+      NS_ENSURE_SUCCESS(rv, rv);
+      RefPtr<PermissionKey> trackingKey =
+          new PermissionKey(kMidoriSyncTrackingOrigin);
+      if (!SnapshotSyncPermission(trackingKey, kMidoriSyncTrackingType)) {
+        rv = AddInternal(trackingPrincipal, kMidoriSyncTrackingType,
+                         DENY_ACTION, ++mLargestID, EXPIRE_NEVER, 0, 0,
+                         eDontNotify, eNoDBOperation);
+        NS_ENSURE_SUCCESS(rv, rv);
+      }
+      mSyncPermissionTracking = true;
+      snapshots.AppendElement(MidoriSyncPermissionSnapshot{
+          nsCString(kMidoriSyncTrackingType),
+          SnapshotSyncPermission(trackingKey, kMidoriSyncTrackingType),
+          trackingKey});
+    }
+    thread = mThread;
+  }
+  if (!thread) {
+    promise->MaybeReject(NS_ERROR_NOT_INITIALIZED);
+    promise.forget(aPromise);
+    return NS_OK;
+  }
+  RefPtr<PermissionManager> self = this;
+  nsCString origin(key->mOrigin);
+  InvokeAsync(thread, __func__,
+              [self, origin,
+               snapshots = snapshots.Clone()]() -> RefPtr<GenericPromise> {
+                auto data = self->mThreadBoundData.Access();
+                if (self->mState == eClosed || !data->mDBConn) {
+                  return GenericPromise::CreateAndReject(
+                      NS_ERROR_NOT_INITIALIZED, __func__);
+                }
+                nsresult result = WriteMidoriSyncPermissionSnapshots(
+                    data->mDBConn, origin, snapshots);
+                return NS_FAILED(result)
+                           ? GenericPromise::CreateAndReject(result, __func__)
+                           : GenericPromise::CreateAndResolve(true, __func__);
+              })
+      ->Then(
+          GetMainThreadSerialEventTarget(), __func__,
+          [self, promise, key, snapshots = snapshots.Clone()](bool) {
+            MonitorAutoLock lock(self->mMonitor);
+            bool current = true;
+            for (const auto& snapshot : snapshots) {
+              current &= MidoriSyncPermissionEntriesEqual(
+                  snapshot.entry,
+                  self->SnapshotSyncPermission(
+                      snapshot.key ? snapshot.key.get() : key.get(),
+                      snapshot.type));
+            }
+            promise->MaybeResolve(current);
+          },
+          [promise](nsresult result) { promise->MaybeReject(result); });
+  promise.forget(aPromise);
+  return NS_OK;
+}
+
+NS_IMETHODIMP
+PermissionManager::GetPermissionSourceFromPrincipal(nsIPrincipal* aPrincipal,
+                                                    const nsACString& aType,
+                                                    nsACString& aSource) {
+  ENSURE_NOT_CHILD_PROCESS;
+  MOZ_ASSERT(NS_IsMainThread());
+  NS_ENSURE_ARG_POINTER(aPrincipal);
+  if (aType.IsEmpty() || aPrincipal->IsSystemPrincipal() ||
+      IsExpandedPrincipal(aPrincipal)) {
+    return NS_ERROR_INVALID_ARG;
+  }
+  if (BasePrincipal::Cast(aPrincipal)
+          ->OriginAttributesRef()
+          .mPrivateBrowsingId) {
+    aSource.AssignLiteral("private");
+    return NS_OK;
+  }
+  nsresult rv;
+  RefPtr<PermissionKey> key = PermissionKey::CreateFromPrincipal(
+      aPrincipal, IsOAForceStripPermission(aType),
+      IsSiteScopedPermission(aType), rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+  MonitorAutoLock lock(mMonitor);
+  EnsureReadCompleted();
+  const int32_t typeIndex = GetTypeIndex(aType, false);
+  const auto* entry = mPermissionTable.GetEntry(key);
+  const int32_t index =
+      entry && typeIndex >= 0 ? entry->GetPermissionIndex(typeIndex) : -1;
+  const nsCString markerType = MidoriSyncOmissionType(aType);
+  const auto marker = markerType.IsEmpty()
+                          ? Nothing()
+                          : SnapshotSyncPermission(key, markerType);
+  if (marker && (index < 0 || entry->GetPermissions()[index].mID ==
+                                  cIDPermissionIsDefault)) {
+    aSource.AssignLiteral("omitted");
+    return NS_OK;
+  }
+  if (index < 0) {
+    aSource.AssignLiteral("absent");
+    return NS_OK;
+  }
+  const auto& permission = entry->GetPermissions()[index];
+  if (HasExpired(permission.mExpireType, permission.mExpireTime)) {
+    aSource.AssignLiteral("expired");
+  } else if (permission.mExpireType == EXPIRE_POLICY) {
+    aSource.AssignLiteral("policy");
+  } else if (permission.mExpireType == EXPIRE_SESSION ||
+             permission.mExpireType == EXPIRE_SESSION_TAB) {
+    aSource.AssignLiteral("session");
+  } else if (permission.mID == cIDPermissionIsDefault) {
+    aSource.AssignLiteral("default");
+  } else if (permission.mPermission == UNKNOWN_ACTION) {
+    aSource.AssignLiteral("unsupported");
+  } else {
+    aSource.AssignLiteral("user");
+  }
   return NS_OK;
 }
 
