+Maybe<PermissionManager::PermissionEntry>
+PermissionManager::SnapshotSyncPermission(PermissionKey* aKey,
+                                          const nsACString& aType) {
+  const int32_t typeIndex = GetTypeIndex(aType, false);
+  const auto* entry = mPermissionTable.GetEntry(aKey);
+  const int32_t index =
+      entry && typeIndex >= 0 ? entry->GetPermissionIndex(typeIndex) : -1;
+  return index >= 0 ? Some(entry->GetPermissions()[index]) : Nothing();
+}
+
+nsresult PermissionManager::RememberSyncPermissionOmission(
+    nsIPrincipal* aPrincipal, const nsACString& aType, uint32_t aReason,
+    int64_t aModificationTime) {
+  const nsCString markerType = MidoriSyncOmissionType(aType);
+  NS_ENSURE_TRUE(!markerType.IsEmpty(), NS_ERROR_INVALID_ARG);
+  nsresult rv;
+  RefPtr<PermissionKey> key = PermissionKey::CreateFromPrincipal(
+      aPrincipal, IsOAForceStripPermission(aType),
+      IsSiteScopedPermission(aType), rv);
+  NS_ENSURE_SUCCESS(rv, rv);
+  nsCOMPtr<nsIPrincipal> normalized;
+  rv = GetPrincipalFromOrigin(key->mOrigin, false, getter_AddRefs(normalized));
+  NS_ENSURE_SUCCESS(rv, rv);
+  NS_ENSURE_TRUE(!normalized->GetIsInPrivateBrowsing(), NS_ERROR_INVALID_ARG);
+  NS_ENSURE_TRUE(mThread, NS_ERROR_NOT_INITIALIZED);
+  rv = AddInternal(normalized, markerType, aReason, ++mLargestID, EXPIRE_NEVER,
+                   0, aModificationTime, eDontNotify, eNoDBOperation);
+  NS_ENSURE_SUCCESS(rv, rv);
+  auto marker = SnapshotSyncPermission(key, markerType);
+  NS_ENSURE_TRUE(marker, NS_ERROR_UNEXPECTED);
+  nsTArray<MidoriSyncPermissionSnapshot> snapshots;
+  snapshots.AppendElement(
+      MidoriSyncPermissionSnapshot{nsCString(aType), Nothing()});
+  snapshots.AppendElement(MidoriSyncPermissionSnapshot{markerType, marker});
+  RefPtr<PermissionManager> self = this;
+  nsCString origin(key->mOrigin);
+  return mThread->Dispatch(NS_NewRunnableFunction(
+      "PermissionManager::RememberSyncPermissionOmission",
+      [self, origin, snapshots = snapshots.Clone()] {
+        auto data = self->mThreadBoundData.Access();
+        if (self->mState == eClosed || !data->mDBConn) {
+          return;
+        }
+        nsresult result = WriteMidoriSyncPermissionSnapshots(data->mDBConn,
+                                                             origin, snapshots);
+        NS_ENSURE_SUCCESS_VOID(result);
+      }));
+}
+
+bool PermissionManager::PreserveSyncPermissionExpiry(
+    nsIPrincipal* aPrincipal, const nsACString& aType,
+    const PermissionEntry& aExpected) {
+  const nsCString type(aType);
+  if (!mSyncPermissionTracking || IsChildProcess() ||
+      MidoriSyncOmissionType(type).IsEmpty() || aExpected.mID < 0 ||
+      aExpected.mExpireType == EXPIRE_SESSION ||
+      aExpected.mExpireType == EXPIRE_POLICY) {
+    return false;
+  }
+  nsresult rv;
+  RefPtr<PermissionKey> key = PermissionKey::CreateFromPrincipal(
+      aPrincipal, IsOAForceStripPermission(type), IsSiteScopedPermission(type),
+      rv);
+  if (NS_FAILED(rv)) {
+    return true;
+  }
+  if (!StringBeginsWith(key->mOrigin, "http://"_ns) &&
+      !StringBeginsWith(key->mOrigin, "https://"_ns)) {
+    return false;
+  }
+  nsCOMPtr<nsIPrincipal> normalized;
+  rv = GetPrincipalFromOrigin(key->mOrigin, false, getter_AddRefs(normalized));
+  if (NS_FAILED(rv)) {
+    return true;
+  }
+  if (normalized->GetIsInPrivateBrowsing()) {
+    return false;
+  }
+  if (!MidoriSyncPermissionEntriesEqual(SnapshotSyncPermission(key, type),
+                                        Some(aExpected))) {
+    return true;
+  }
+  rv = RememberSyncPermissionOmission(normalized, type, DENY_ACTION,
+                                      aExpected.mModificationTime);
+  if (NS_FAILED(rv)) {
+    return true;
+  }
+  (void)AddInternal(normalized, type, UNKNOWN_ACTION, 0, EXPIRE_NEVER, 0, 0,
+                    eNotify, eNoDBOperation);
+  return true;
+}
+
+Maybe<nsresult> PermissionManager::AddSyncLocalPermission(
+    nsIPrincipal* aPrincipal, const nsACString& aType, uint32_t aPermission,
+    uint32_t aExpireType, int64_t aExpireTime) {
+  if ((aExpireType != EXPIRE_SESSION && aExpireType != EXPIRE_POLICY) ||
+      MidoriSyncOmissionType(aType).IsEmpty()) {
+    return Nothing();
+  }
+  nsresult rv;
+  RefPtr<PermissionKey> key = PermissionKey::CreateFromPrincipal(
+      aPrincipal, IsOAForceStripPermission(aType),
+      IsSiteScopedPermission(aType), rv);
+  if (NS_FAILED(rv)) {
+    return Some(rv);
+  }
+  if (!StringBeginsWith(key->mOrigin, "http://"_ns) &&
+      !StringBeginsWith(key->mOrigin, "https://"_ns)) {
+    return Nothing();
+  }
+  nsCOMPtr<nsIPrincipal> normalized;
+  rv = GetPrincipalFromOrigin(key->mOrigin, false, getter_AddRefs(normalized));
+  if (NS_FAILED(rv)) {
+    return Some(rv);
+  }
+  if (normalized->GetIsInPrivateBrowsing()) {
+    return Nothing();
+  }
+  EnsureReadCompleted();
+  if (!mThread || !mSyncPermissionTracking) {
+    return Nothing();
+  }
+  const auto before = SnapshotSyncPermission(key, aType);
+  if (aPrincipal->GetIsInPrivateBrowsing() &&
+      (!before || before->mID < 0 ||
+       (before->mExpireType != EXPIRE_NEVER &&
+        before->mExpireType != EXPIRE_TIME))) {
+    return Nothing();
+  }
+  const int64_t id = before && before->mID >= 0 ? before->mID : ++mLargestID;
+  rv = AddInternal(aPrincipal, aType, aPermission, id, aExpireType, aExpireTime,
+                   0, eDontNotify, eNoDBOperation);
+  if (NS_FAILED(rv)) {
+    return Some(rv);
+  }
+  const auto after = SnapshotSyncPermission(key, aType);
+  const bool removed = aPermission == UNKNOWN_ACTION;
+  if ((!removed && (!after || after->mPermission != aPermission ||
+                    after->mExpireType != aExpireType)) ||
+      (removed && after && after->mID >= 0 &&
+       after->mPermission != UNKNOWN_ACTION)) {
+    return Some(NS_OK);
+  }
+  rv = RememberSyncPermissionOmission(
+      aPrincipal, aType, aExpireType == EXPIRE_POLICY ? 4 : 3,
+      aPrincipal->GetIsInPrivateBrowsing() && before ? before->mModificationTime
+                                                     : 0);
+  if (NS_FAILED(rv)) {
+    return Some(rv);
+  }
+  IPC::Permission permission(key->mOrigin, aType, aPermission, aExpireType,
+                             aExpireTime);
+  nsAutoCString permissionKey;
+  GetKeyForPermission(aPrincipal, aType, permissionKey);
+  nsTArray<ContentParent*> parents;
+  ContentParent::GetAll(parents);
+  for (auto* parent : parents) {
+    if (parent->NeedsPermissionsUpdate(permissionKey)) {
+      (void)parent->SendAddPermission(permission);
+    }
+  }
+  if (!MidoriSyncPermissionEntriesEqual(before, after)) {
+    if (!removed && !aPrincipal->GetIsInPrivateBrowsing()) {
+      UpdateLastInteractionInternal(key->mOrigin);
+    }
+    const auto& shown = removed && before ? *before : *after;
+    NotifyObserversWithPermission(aPrincipal, aType, shown.mPermission,
+                                  shown.mExpireType, shown.mExpireTime,
+                                  shown.mModificationTime,
+                                  removed  ? u"deleted"_ns
+                                  : before ? u"changed"_ns
+                                           : u"added"_ns);
+  }
+  return Some(NS_OK);
+}
