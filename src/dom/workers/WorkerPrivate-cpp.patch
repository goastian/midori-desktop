+bool WorkerPrivate::IsCpuBudgetBackground() const {
+  AssertIsOnWorkerThread();
+  return mMidoriCpuBackground.valueOr(bool(mIsInBackground)) &&
+         !mIsPlayingAudio && !mHasActivePeerConnections;
+}
+
+void WorkerPrivate::SetCpuBudgetBackground(bool aBackground) {
+  RefPtr<MidoriCpuBackgroundRunnable> runnable =
+      new MidoriCpuBackgroundRunnable(aBackground);
+  static_cast<void>(runnable->Dispatch(this));
+}
+
+void WorkerPrivate::UpdateCpuBudgetBackgroundInternal(bool aBackground) {
+  AssertIsOnWorkerThread();
+  if (mMidoriCpuBackground == Some(aBackground)) {
+    return;
+  }
+  mMidoriCpuBackground = Some(aBackground);
+  UpdateCpuBudgetRole(true);
+  auto data = mWorkerThreadAccessible.Access();
+  for (WorkerPrivate* child : data->mChildWorkers) {
+    child->SetCpuBudgetBackground(aBackground);
+  }
+}
+
+void WorkerPrivate::UpdateCpuBudgetRateInternal() {
+  AssertIsOnWorkerThread();
+  const bool background = IsCpuBudgetBackground();
+  if (!mMidoriCpuGovernor && background && CurrentManagedWorkerCpuRate())
+    mMidoriCpuGovernor = MakeUnique<MidoriWorkerCpuBudget>(this);
+  if (mMidoriCpuGovernor) mMidoriCpuGovernor->Refresh(background);
+}
+
+void WorkerPrivate::UpdateCpuBudgetRole(bool aAlive) {
+  AssertIsOnWorkerThread();
+  SetManagedWorkerCpuTarget(ControlEventTarget(), aAlive);
+  if (aAlive) {
+    const bool background = IsCpuBudgetBackground();
+    if (!mMidoriCpuGovernor && background && CurrentManagedWorkerCpuRate())
+      mMidoriCpuGovernor = MakeUnique<MidoriWorkerCpuBudget>(this);
+    if (mMidoriCpuGovernor) mMidoriCpuGovernor->Refresh(background);
+  } else if (mMidoriCpuGovernor) {
+    mMidoriCpuGovernor->Stop();
+  }
+#if (defined(XP_LINUX) && !defined(ANDROID)) || defined(XP_WIN) || \
+    defined(XP_MACOSX)
+  if (!aAlive && !mMidoriCpuRoleRegistered) return;
+  auto* actor = BackgroundChild::GetForCurrentThread();
+  if (!actor) return;
+  bool background = IsCpuBudgetBackground();
+  if (actor->SendMidoriWorkerCpuRole(
+          static_cast<uint64_t>(PlatformThread::CurrentId()), background,
+          aAlive)) {
+    mMidoriCpuRoleRegistered = aAlive;
+  }
+#else
+  static_cast<void>(aAlive);
+#endif
+}
