+void nsGlobalWindowInner::UpdateSharedWorkersCpuBudget(bool aIsPlayingAudio) {
+  const bool background =
+      IsBackgroundInternal() && !aIsPlayingAudio && !HasActivePeerConnections();
+  if (mWindowGlobalChild && mWindowGlobalChild->CanSend() &&
+      mMidoriWindowCpuBackground != Some(background) &&
+      mWindowGlobalChild->SendUpdateCpuBudget(background)) {
+    mMidoriWindowCpuBackground = Some(background);
+  }
+  for (RefPtr<SharedWorker> worker : mSharedWorkers.ForwardRange()) {
+    worker->UpdateCpuBudget(background);
+  }
+}
