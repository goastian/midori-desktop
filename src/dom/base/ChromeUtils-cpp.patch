+uint64_t ChromeUtils::BeginManagedMediaObservation(GlobalObject&,
+                                                   ErrorResult& aRv) {
+  uint64_t generation = 0;
+  const nsresult rv = MidoriMediaTrace::Begin(generation);
+  if (NS_FAILED(rv)) aRv.Throw(rv);
+  return generation;
+}
+
+void ChromeUtils::EndManagedMediaObservation(
+    GlobalObject&, uint64_t aGeneration, HTMLVideoElement& aVideo,
+    ManagedMediaObservationResult& aResult, ErrorResult& aRv) {
+  MidoriMediaTraceBatch batch;
+  const nsresult rv = MidoriMediaTrace::Finish(aGeneration, batch);
+  if (NS_FAILED(rv)) {
+    aRv.Throw(rv);
+    return;
+  }
+  auto* window = aVideo.OwnerDoc()->GetInnerWindow();
+  auto* performance = window ? window->GetPerformance() : nullptr;
+  if (!performance) {
+    aRv.Throw(NS_ERROR_NOT_AVAILABLE);
+    return;
+  }
+  aResult.mProcessId = base::GetCurrentProcId();
+  aResult.mGeneration = batch.generation;
+  aResult.mCapacity = batch.capacity;
+  aResult.mStarted = batch.started;
+  aResult.mFinished = batch.finished;
+  aResult.mDocumentOrigin =
+      (performance->CreationTimeStamp() - TimeStamp::ProcessCreation())
+          .ToMilliseconds();
+  aResult.mContainer.Assign(nsPrintfCString(
+      "%p", static_cast<const void*>(aVideo.GetImageContainer())));
+  aResult.mTruncated = batch.truncated;
+  aResult.mExpired = batch.expired;
+  if (!aResult.mEntries.SetCapacity(batch.count, fallible)) {
+    aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  for (uint32_t i = 0; i < batch.count; ++i) {
+    const auto& entry = batch.entries[i];
+    auto* row = aResult.mEntries.AppendElement(fallible);
+    if (!row) {
+      aRv.Throw(NS_ERROR_OUT_OF_MEMORY);
+      return;
+    }
+    row->mOrdinal = i + 1;
+    row->mKind = entry.kind;
+    row->mContext.Assign(nsPrintfCString("%p", entry.context));
+    row->mRtp = entry.rtp;
+    row->mRawRtp = entry.rawRtp;
+    row->mSsrc = entry.ssrc;
+    row->mSourceCode = entry.sourceCode;
+    row->mProducer = entry.producer;
+    row->mFrame = entry.frame;
+    row->mPaint = entry.paint;
+    row->mObserved = entry.observed;
+    row->mPresented = entry.presented;
+    row->mValid = entry.valid;
+  }
+}
