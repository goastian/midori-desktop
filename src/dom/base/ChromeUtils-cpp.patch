+already_AddRefed<Promise> ChromeUtils::RequestManagedSocketUsage(
+    GlobalObject& aGlobal, bool aSocketProcess, ErrorResult& aRv) {
+  if (!NS_IsMainThread() || !XRE_IsParentProcess()) {
+    aRv.Throw(NS_ERROR_NOT_AVAILABLE);
+    return nullptr;
+  }
+  nsCOMPtr<nsIGlobalObject> global = do_QueryInterface(aGlobal.GetAsSupports());
+  RefPtr<Promise> promise = Promise::Create(global, aRv);
+  if (aRv.Failed()) return nullptr;
+  net::MidoriNetworkBudget::SampleSocketUsage(aSocketProcess)
+      ->Then(
+          GetMainThreadSerialEventTarget(), __func__,
+          [promise](const net::MidoriNetworkBudget::SocketUsage& aUsage) {
+            MidoriManagedSocketUsage value;
+            value.mProcessId = aUsage.processId;
+            value.mSent = aUsage.sent;
+            value.mReceived = aUsage.received;
+            AutoJSAPI jsapi;
+            if (!jsapi.Init(promise->GetGlobalObject())) {
+              promise->MaybeReject(NS_ERROR_UNEXPECTED);
+              return;
+            }
+            JSContext* cx = jsapi.cx();
+            JS::Rooted<JS::Value> result(cx);
+            JS::Rooted<JSObject*> budget(cx, JS_NewPlainObject(cx));
+            if (!budget || !ToJSValue(cx, value, &result)) {
+              promise->MaybeRejectWithExceptionFromContext(cx);
+              return;
+            }
+            if (!JS_DefineProperty(cx, budget, "downloadBps",
+                                   double(aUsage.budget.downloadBps),
+                                   JSPROP_ENUMERATE) ||
+                !JS_DefineProperty(cx, budget, "uploadBps",
+                                   double(aUsage.budget.uploadBps),
+                                   JSPROP_ENUMERATE) ||
+                !JS_DefineProperty(cx, budget, "downloadGeneration",
+                                   double(aUsage.budget.downloadGeneration),
+                                   JSPROP_ENUMERATE) ||
+                !JS_DefineProperty(cx, budget, "uploadGeneration",
+                                   double(aUsage.budget.uploadGeneration),
+                                   JSPROP_ENUMERATE) ||
+                !JS_DefineProperty(cx, budget, "globalMediaSendingCalls",
+                                   double(net::MidoriNetworkBudget::
+                                              GlobalMediaSendingCallCount()),
+                                   JSPROP_ENUMERATE)) {
+              promise->MaybeRejectWithExceptionFromContext(cx);
+              return;
+            }
+            JS::Rooted<JSObject*> object(cx, &result.toObject());
+            JS::Rooted<JS::Value> budgetValue(cx, JS::ObjectValue(*budget));
+            if (!JS_DefineProperty(cx, object, "budget", budgetValue,
+                                   JSPROP_ENUMERATE)) {
+              promise->MaybeRejectWithExceptionFromContext(cx);
+              return;
+            }
+            promise->MaybeResolve(result);
+          },
+          [promise](nsresult aError) { promise->MaybeReject(aError); });
+  return promise.forget();
+}
