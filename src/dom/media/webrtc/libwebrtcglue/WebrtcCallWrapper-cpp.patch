+void WebrtcCallWrapper::SetMediaSending(MediaSessionConduit* aConduit,
+                                        bool aActive) {
+  MOZ_ASSERT(mCallThread->IsOnCurrentThread());
+  if (aActive && !mCall) return;
+  const bool wasSending = !mSendingConduits.empty();
+  if (aActive) {
+    mSendingConduits.insert(aConduit);
+  } else {
+    mSendingConduits.erase(aConduit);
+  }
+  const bool sending = !mSendingConduits.empty();
+  if (wasSending != sending) {
+    net::MidoriNetworkBudget::ReportMediaSending(mSendSourceId, sending);
+  }
+}
+
+void WebrtcCallWrapper::UpdateNetworkBudget() {
+  MOZ_ASSERT(mCallThread->IsOnCurrentThread());
+  if (mCall) mCall->UpdateExternalBitrateLimits();
+}
+
 void WebrtcCallWrapper::Destroy() {
   MOZ_ASSERT(mCallThread->IsOnCurrentThread());
+  MOZ_LOG_FMT(sSendCompletionLog, LogLevel::Debug, "destroy source={} wall_at={}",
+              mSendSourceId, PR_Now() / 1000);
+  mNetworkBudgetListener.DisconnectIfExists();
+  mPacketsSentListener.DisconnectIfExists();
+  if (!mSendingConduits.empty()) {
+    mSendingConduits.clear();
+    net::MidoriNetworkBudget::ReportMediaSending(mSendSourceId, false);
+  }
   mCall = nullptr;
   mShutdownTicket = nullptr;
 }
