+
+void WebrtcCallWrapper::ObservePacketsSent(MediaTransportHandler* aHandler) {
+  MOZ_ASSERT(NS_IsMainThread());
+  mPacketsSentListener = aHandler->GetPacketsSent().Connect(
+      mCallThread.get(), this, &WebrtcCallWrapper::OnPacketsSent);
+}
+
+void WebrtcCallWrapper::OnPacketsSent(
+    const nsTArray<dom::RTCSentPacket>& aPackets) {
+  MOZ_ASSERT(mCallThread->IsOnCurrentThread());
+  if (!mCall) return;
+  MOZ_LOG_FMT(sSendCompletionLog, LogLevel::Debug,
+              "call-batch packets={}", aPackets.Length());
+  for (const auto& packet : aPackets) {
+    if (packet.sourceId() != mSendSourceId || packet.sentAt().IsNull())
+      continue;
+    const int64_t sentAt = dom::RTCStatsTimestamp::FromMozTime(
+                               GetTimestampMaker(), packet.sentAt())
+                               .ToRealtime()
+                               .ms();
+    MOZ_LOG_FMT(sSendCompletionLog, LogLevel::Debug,
+                "call source={} id={} at={} age_ms={}", packet.sourceId(),
+                packet.packetId(), sentAt,
+                (TimeStamp::Now() - packet.sentAt()).ToMilliseconds());
+    mCall->OnSentPacket({packet.packetId(), sentAt});
+  }
 }
 
