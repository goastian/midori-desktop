+
+void MediaTransportEvents::OnDatagramSent(uint64_t aSourceId, int64_t aPacketId,
+                                          const TimeStamp& aSentAt,
+                                          bool aSocketSent) {
+  MOZ_LOG_FMT(sMidoriWebrtcSendLog, LogLevel::Debug,
+              "sent source={} id={} age_ms={} socket={}", aSourceId, aPacketId,
+              (TimeStamp::Now() - aSentAt).ToMilliseconds(), aSocketSent);
+  mSentPackets.AppendElement(
+      dom::RTCSentPacket(aSourceId, aPacketId, aSentAt, aSocketSent));
+  if (mSentPackets.Length() >= 64) FlushSentPackets();
+  if (mSentFlushPending) return;
+  mSentFlushPending = true;
+  nsresult rv = NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+      "MediaTransportEvents::FlushSentPackets", [self = RefPtr{this}] {
+        self->mSentFlushPending = false;
+        self->FlushSentPackets();
+      }));
+  if (NS_FAILED(rv)) {
+    mSentFlushPending = false;
+    mSentPackets.Clear();
+  }
+}
+
+void MediaTransportEvents::FlushSentPackets() {
+  if (mSentPackets.IsEmpty()) return;
+  nsTArray<dom::RTCSentPacket> packets;
+  packets.SwapElements(mSentPackets);
+  MOZ_LOG_FMT(sMidoriWebrtcSendLog, LogLevel::Debug,
+              "batch packets={}", packets.Length());
+  mPacketsSent.Notify(std::move(packets));
+}
+
+void MediaTransportEvents::OnPacketsSent(
+    nsTArray<dom::RTCSentPacket>&& aPackets) {
+  mPacketsSent.Notify(std::move(aPackets));
 }
 
