+
+void NrUdpSocketIpc::ExpireQueuedMedia() {
+  if (!output_ || output_->nextMediaExpiry.IsNull()) return;
+  const TimeStamp now = TimeStamp::Now();
+  if (output_->nextMediaExpiry > now) return;
+  output_->nextMediaExpiry = TimeStamp();
+  for (auto packet = output_->packets.begin();
+       packet != output_->packets.end();) {
+    if ((*packet)->inFlight || (*packet)->options.expires.IsNull() ||
+        (*packet)->options.expires > now) {
+      if (!(*packet)->inFlight && !(*packet)->options.expires.IsNull() &&
+          (output_->nextMediaExpiry.IsNull() ||
+           (*packet)->options.expires < output_->nextMediaExpiry)) {
+        output_->nextMediaExpiry = (*packet)->options.expires;
+      }
+      ++packet;
+      continue;
+    }
+    output_->queuedBytes -= (*packet)->charge;
+    (*packet)->ReleaseData();
+    packet = output_->packets.erase(packet);
+  }
+}
+
+void NrUdpSocketIpc::ClearOutput() {
+  if (!output_) return;
+  for (auto& packet : output_->packets) packet->request.DisconnectIfExists();
+  output_.reset();
+}
+
+void NrUdpSocketIpc::ScheduleOutput() {
+  ASSERT_ON_THREAD(sts_thread_);
+  if (!output_ || output_->flushPending || output_->retryPending) return;
+  output_->flushPending = true;
+  nsresult rv = NS_DispatchToCurrentThread(NS_NewRunnableFunction(
+      "NrUdpSocketIpc::FlushOutput", [self = RefPtr{this}]() {
+        if (!self->output_) return;
+        self->output_->flushPending = false;
+        self->FlushOutput();
+      }));
+  if (NS_FAILED(rv)) {
+    err_ = true;
+    ClearOutput();
+  }
+}
+
+void NrUdpSocketIpc::FlushOutput() {
+  static_assert(sizeof(PendingOutput) <= 256);
+  ASSERT_ON_THREAD(sts_thread_);
+  ReentrantMonitorAutoEnter mon(monitor_);
+  if (!output_ || output_->retryPending || state_ != NR_CONNECTED || err_)
+    return;
+  ExpireQueuedMedia();
+  for (auto& packet : output_->packets) {
+    if (packet->done || packet->inFlight) continue;
+    if (output_->inFlightCount >= 32 ||
+        (output_->inFlightCount &&
+         output_->inFlightBytes + packet->charge > 64 * 1024))
+      break;
+    packet->inFlight = true;
+    ++output_->inFlightCount;
+    output_->inFlightBytes += packet->charge;
+    RefPtr<net::DatagramSendPromise::Private> completion =
+        new net::DatagramSendPromise::Private(__func__);
+    completion
+        ->Then(
+            GetCurrentSerialEventTarget(), __func__,
+            [self = RefPtr{this}, packet](
+                const net::DatagramSendPromise::ResolveOrRejectValue& value) {
+              self->CompleteOutput(
+                  packet, value.IsResolve() ? NS_OK : value.RejectValue(),
+                  value.IsResolve() ? value.ResolveValue() : TimeStamp());
+            })
+        ->Track(packet->request);
+    nsresult rv = io_thread_->Dispatch(
+        NS_NewRunnableFunction("NrUdpSocketIpc::sendto_ack_i",
+                               [self = RefPtr{this}, packet, completion]() {
+                                 self->sendto_ack_i(packet, completion);
+                               }),
+        NS_DISPATCH_NORMAL);
+    if (NS_FAILED(rv)) completion->Reject(rv, __func__);
+  }
+}
+
+void NrUdpSocketIpc::sendto_ack_i(
+    RefPtr<PendingOutput> aPacket,
+    RefPtr<net::DatagramSendPromise::Private> aCompletion) {
+  ASSERT_ON_THREAD(io_thread_);
+  ReentrantMonitorAutoEnter mon(monitor_);
+  if (!socket_child_ || state_ != NR_CONNECTED || err_) {
+    aCompletion->Reject(NS_BASE_STREAM_CLOSED, __func__);
+    return;
+  }
+  socket_child_
+      ->SendWithAddressAndAck(aPacket->address, aPacket->data,
+                              aPacket->options.expires, aPacket->options.audio)
+      ->Then(GetCurrentSerialEventTarget(), __func__,
+             [aCompletion](
+                 const net::DatagramSendPromise::ResolveOrRejectValue& value) {
+               if (value.IsResolve())
+                 aCompletion->Resolve(value.ResolveValue(), __func__);
+               else
+                 aCompletion->Reject(value.RejectValue(), __func__);
+             });
+}
+
+void NrUdpSocketIpc::CompleteOutput(RefPtr<PendingOutput> aPacket,
+                                    nsresult aResult,
+                                    const TimeStamp& aSentAt) {
+  ASSERT_ON_THREAD(sts_thread_);
+  ReentrantMonitorAutoEnter mon(monitor_);
+  if (!output_ || !aPacket->inFlight) return;
+  aPacket->request.Complete();
+  aPacket->inFlight = false;
+  --output_->inFlightCount;
+  output_->inFlightBytes -= aPacket->charge;
+  if (aResult == NS_BASE_STREAM_WOULD_BLOCK) {
+    if (!output_->retryPending) {
+      output_->retryPending = true;
+      nsresult rv = NS_DelayedDispatchToCurrentThread(
+          NS_NewRunnableFunction("NrUdpSocketIpc::RetryOutput",
+                                 [self = RefPtr{this}]() {
+                                   if (!self->output_) return;
+                                   self->output_->retryPending = false;
+                                   self->FlushOutput();
+                                 }),
+          50);
+      if (NS_FAILED(rv)) {
+        err_ = true;
+        close();
+      }
+    }
+    return;
+  }
+  if (NS_FAILED(aResult)) {
+    err_ = true;
+    close();
+    return;
+  }
+  aPacket->done = true;
+  aPacket->options.sent.Notify(aSentAt);
+  output_->queuedBytes -= aPacket->charge;
+  aPacket->ReleaseData();
+  auto position =
+      std::find(output_->packets.begin(), output_->packets.end(), aPacket);
+  MOZ_ASSERT(position != output_->packets.end());
+  if (position != output_->packets.end()) output_->packets.erase(position);
+  FlushOutput();
+  if (poll_flags() & PR_POLL_WRITE) fire_callback(NR_ASYNC_WAIT_WRITE);
+}
+
+NrUdpSocketIpc::~NrUdpSocketIpc() { ClearOutput(); }
 
