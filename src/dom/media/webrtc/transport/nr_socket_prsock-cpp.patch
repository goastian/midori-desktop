+
+void NrSocket::ForgetResourceQuota() {
+  net::MidoriNetworkBudget::ForgetDatagramFlow(
+      net::MidoriNetworkBudget::Direction::Download, this);
+  net::MidoriNetworkBudget::ForgetDatagramFlow(
+      net::MidoriNetworkBudget::Direction::Upload, this);
+}
+
+void NrSocket::UpdatePollFlags() {
+  mPollFlags = poll_flags();
+  if (input_quota_pending_) mPollFlags &= ~PR_POLL_READ;
+  if (output_quota_pending_) mPollFlags &= ~PR_POLL_WRITE;
+}
+
+void NrSocket::EnsureReceiveHeadroom() {
+  if (my_addr_.protocol == IPPROTO_UDP && last_input_size_ >= 512 &&
+      (!receive_headroom_ || !receive_headroom_->Renew())) {
+    receive_headroom_ = net::DatagramReceiveHeadroom::Create(fd_);
+  }
+}
+
+bool NrSocket::WaitForResourceQuota(bool aInput) {
+  const uint16_t flag = aInput ? PR_POLL_READ : PR_POLL_WRITE;
+  if (!fd_ || NS_FAILED(mCondition) || !(poll_flags() & flag)) return false;
+  const auto direction = aInput ? net::MidoriNetworkBudget::Direction::Download
+                                : net::MidoriNetworkBudget::Direction::Upload;
+  if (aInput && my_addr_.protocol == IPPROTO_UDP &&
+      net::MidoriNetworkBudget::DownloadRate()) {
+    PRPollDesc pendingRead{fd_, PR_POLL_READ, 0};
+    if (PR_Poll(&pendingRead, 1, PR_INTERVAL_NO_WAIT) <= 0 ||
+        !(pendingRead.out_flags & PR_POLL_READ)) {
+      net::MidoriNetworkBudget::CancelDatagramDemand(direction, this);
+    }
+  }
+  const uint32_t delay = net::MidoriNetworkBudget::WaitMilliseconds(
+      direction, my_addr_.protocol == IPPROTO_UDP, this);
+  if (!delay) return false;
+  bool& pending = aInput ? input_quota_pending_ : output_quota_pending_;
+  if (!pending) {
+    pending = true;
+    const nsresult rv = NS_DelayedDispatchToCurrentThread(
+        NS_NewRunnableFunction("NrSocket::ResourceQuota",
+                               [self = RefPtr{this}, aInput]() {
+                                 (aInput ? self->input_quota_pending_
+                                         : self->output_quota_pending_) = false;
+                                 if (!self->fd_ || NS_FAILED(self->mCondition))
+                                   return;
+                                 self->WaitForResourceQuota(aInput);
+                                 self->UpdatePollFlags();
+                               }),
+        delay);
+    if (NS_FAILED(rv)) {
+      pending = false;
+      close();
+      return false;
+    }
+  }
+  UpdatePollFlags();
+  return true;
+}
+
+int NrSocket::SendDatagramNow(const void* aData, uint32_t aLength, int aFlags,
+                              const PRNetAddr& aAddress,
+                              const net::DatagramSendInfo& aSent) {
+  if (!fd_ || NS_FAILED(mCondition)) return R_EOD;
+  const auto reservation = net::MidoriNetworkBudget::Reserve(
+      net::MidoriNetworkBudget::Direction::Upload, aLength, true, this);
+  if (aLength && !reservation.bytes) return R_WOULDBLOCK;
+  const int32_t sent =
+      PR_SendTo(fd_, aData, aLength, aFlags, &aAddress, PR_INTERVAL_NO_WAIT);
+  const TimeStamp sentAt = sent >= 0 ? TimeStamp::Now() : TimeStamp();
+  const PRErrorCode error = sent < 0 ? PR_GetError() : 0;
+  net::MidoriNetworkBudget::Refund(net::MidoriNetworkBudget::Direction::Upload,
+                                   reservation, sent > 0 ? sent : 0);
+  if (sent < 0)
+    return error == PR_WOULD_BLOCK_ERROR ? R_WOULDBLOCK : R_IO_ERROR;
+  if (uint32_t(sent) != aLength) return R_IO_ERROR;
+  profiler_count_bandwidth_written_bytes(sent);
+  aSent.Notify(sentAt);
+  if (!queued_output_ || queued_output_->empty()) {
+    net::MidoriNetworkBudget::CancelDatagramDemand(
+        net::MidoriNetworkBudget::Direction::Upload, this);
+  }
+  return 0;
+}
+
+void NrSocket::ClearQueuedOutput() {
+  net::MidoriNetworkBudget::CancelDatagramDemand(
+      net::MidoriNetworkBudget::Direction::Upload, this);
+  static_assert(sizeof(QueuedDatagram) <= 256);
+  next_media_expiry_ = TimeStamp();
+  if (!queued_output_) return;
+  while (!queued_output_->empty()) {
+    const auto& packet = queued_output_->front();
+    if (packet.sent.packetId >= 0) {
+      MOZ_LOG_FMT(sNrSendCompletionLog, LogLevel::Debug,
+                  "drop source={} id={} wall_at={} reason=close",
+                  packet.sent.sourceId, packet.sent.packetId, PR_Now() / 1000);
+    }
+    const uint32_t charge = queued_output_->front().charge;
+    queued_output_->pop_front();
+    net::MidoriNetworkBudget::ReleaseDatagramBytes(charge);
+  }
+  queued_output_.reset();
+  queued_output_bytes_ = 0;
+}
+
+void NrSocket::ExpireQueuedMedia() {
+  if (!queued_output_ || next_media_expiry_.IsNull()) return;
+  const TimeStamp now = TimeStamp::Now();
+  if (next_media_expiry_ > now) return;
+  next_media_expiry_ = TimeStamp();
+  for (auto packet = queued_output_->begin();
+       packet != queued_output_->end();) {
+    if (!packet->expires.IsNull() && packet->expires <= now) {
+      if (packet->sent.packetId >= 0) {
+        MOZ_LOG_FMT(sNrSendCompletionLog, LogLevel::Debug,
+                    "drop source={} id={} wall_at={} reason=expired",
+                    packet->sent.sourceId, packet->sent.packetId,
+                    PR_Now() / 1000);
+      }
+      const uint32_t charge = packet->charge;
+      packet = queued_output_->erase(packet);
+      queued_output_bytes_ -= charge;
+      net::MidoriNetworkBudget::ReleaseDatagramBytes(charge);
+    } else {
+      if (!packet->expires.IsNull() && (next_media_expiry_.IsNull() ||
+                                        packet->expires < next_media_expiry_)) {
+        next_media_expiry_ = packet->expires;
+      }
+      ++packet;
+    }
+  }
+  if (queued_output_->empty()) {
+    net::MidoriNetworkBudget::CancelDatagramDemand(
+        net::MidoriNetworkBudget::Direction::Upload, this);
+  }
+}
+
+void NrSocket::ScheduleQueuedOutput() {
+  if (queue_wake_pending_ || !queued_output_ || queued_output_->empty()) return;
+  queue_wake_pending_ = true;
+  const uint32_t delay = std::max(
+      10U, net::MidoriNetworkBudget::WaitMilliseconds(
+               net::MidoriNetworkBudget::Direction::Upload, true, this));
+  const nsresult rv = NS_DelayedDispatchToCurrentThread(
+      NS_NewRunnableFunction("NrSocket::FlushQueuedOutput",
+                             [self = RefPtr{this}]() {
+                               self->queue_wake_pending_ = false;
+                               self->FlushQueuedOutput();
+                             }),
+      delay);
+  if (NS_FAILED(rv)) {
+    queue_wake_pending_ = false;
+    close();
+  }
+}
+
+void NrSocket::FlushQueuedOutput() {
+  if (!queued_output_) return;
+  if (!fd_ || NS_FAILED(mCondition)) {
+    ClearQueuedOutput();
+    return;
+  }
+  uint32_t sent = 0;
+  while (sent < 64) {
+    ExpireQueuedMedia();
+    if (queued_output_->empty()) break;
+    const auto& packet = queued_output_->front();
+    const int result =
+        SendDatagramNow(packet.data.Elements(), packet.data.Length(),
+                        packet.flags, packet.address, packet.sent);
+    if (result == R_WOULDBLOCK) break;
+    if (result) {
+      close();
+      return;
+    }
+    const uint32_t charge = packet.charge;
+    queued_output_->pop_front();
+    queued_output_bytes_ -= charge;
+    net::MidoriNetworkBudget::ReleaseDatagramBytes(charge);
+    ++sent;
+  }
+  if (queued_output_->empty()) {
+    net::MidoriNetworkBudget::CancelDatagramDemand(
+        net::MidoriNetworkBudget::Direction::Upload, this);
+  }
+  ScheduleQueuedOutput();
 }
 
