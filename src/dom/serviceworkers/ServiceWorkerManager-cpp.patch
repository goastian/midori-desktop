+
+bool ServiceWorkerManager::IsClientControlledByWorker(
+    const nsID& aClientId, const ServiceWorkerInfo* aWorker) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!gInstance || !aWorker) return false;
+  auto entry = gInstance->mControlledClients.Lookup(aClientId);
+  return entry && entry.Data()->mRegistrationInfo->GetActive() == aWorker;
+}
+
+void ServiceWorkerManager::NotifyClientCpuBudgetChanged(
+    const ClientInfo& aClientInfo) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!gInstance || gInstance->mShuttingDown) return;
+  RefPtr<ServiceWorkerRegistrationInfo> registration;
+  {
+    auto entry = gInstance->mControlledClients.Lookup(aClientInfo.Id());
+    if (entry) registration = entry.Data()->mRegistrationInfo;
+  }
+  if (registration) gInstance->UpdateRegistrationCpuBudget(registration);
+}
+
+void ServiceWorkerManager::UpdateRegistrationCpuBudget(
+    ServiceWorkerRegistrationInfo* aRegistration) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (mShuttingDown || !aRegistration || !aRegistration->GetActive()) return;
+  bool background = true;
+  for (const auto& client : mControlledClients.Values()) {
+    if (client->mRegistrationInfo != aRegistration) continue;
+    RefPtr<WindowGlobalParent> window =
+        WindowGlobalParent::GetByClientId(client->mClientHandle->Info().Id());
+    if (!window || !window->IsCpuBudgetBackground()) {
+      background = false;
+      break;
+    }
+  }
+  aRegistration->GetActive()->WorkerPrivate()->SetCpuBudgetBackground(
+      background);
 }
 
