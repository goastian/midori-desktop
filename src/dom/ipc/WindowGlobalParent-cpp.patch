+
+already_AddRefed<WindowGlobalParent> WindowGlobalParent::GetByClientId(
+    const nsID& aClientId) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!sCpuBudgetClientWindows) return nullptr;
+  auto entry = sCpuBudgetClientWindows->Lookup(aClientId);
+  if (!entry) return nullptr;
+  RefPtr<WindowGlobalParent> window = GetByInnerWindowId(entry.Data());
+  if (!window || window->IsClosed() || !window->mClientInfo ||
+      window->mClientInfo->Id() != aClientId)
+    return nullptr;
+  return window.forget();
+}
