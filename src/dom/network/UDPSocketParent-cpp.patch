+mozilla::ipc::IPCResult UDPSocketParent::FilterOutgoingPacket(
+    const NetAddr& aAddress, const nsTArray<uint8_t>& aData) {
+  bool allowed = false;
+  UDPSOCKET_LOG(("%s(%s:%d): Filtering outgoing packet", __FUNCTION__,
+                 mAddress.addr().get(), mAddress.port()));
+  nsresult rv =
+      mFilter->FilterPacket(&aAddress, aData.Elements(), aData.Length(),
+                            nsISocketFilter::SF_OUTGOING, &allowed);
+  // Sending unallowed data, kill content or socket process at the other end.
+  if (NS_WARN_IF(NS_FAILED(rv)) || !allowed) {
+    return IPC_FAIL(this, "Content tried to send non STUN packet");
+  }
+  return IPC_OK();
+}
+
+mozilla::ipc::IPCResult UDPSocketParent::RecvOutgoingDataWithAck(
+    nsTArray<uint8_t>&& aData, const NetAddr& aAddress,
+    const TimeStamp& aExpires, const bool& aAudio,
+    OutgoingDataWithAckResolver&& aResolve) {
+  if (!mSocket) {
+    aResolve(UDPDatagramResult(static_cast<uint32_t>(NS_BASE_STREAM_CLOSED),
+                               TimeStamp()));
+    return IPC_OK();
+  }
+  if (mFilter) {
+    auto result = FilterOutgoingPacket(aAddress, aData);
+    if (!result) return result;
+  }
+  auto options = net::DatagramSendOptions::ForWebRTC(
+      aData.Elements(), aData.Length(),
+      net::MidoriNetworkBudget::UploadRate() > 0 || !aExpires.IsNull(), aAudio);
+  if (!options.expires.IsNull() && !aExpires.IsNull()) {
+    options.expires = std::min(options.expires, aExpires);
+  }
+  net::SendDatagramWithCompletion(mSocket, aAddress, aData, options)
+      ->Then(GetCurrentSerialEventTarget(), __func__,
+             [resolve = std::move(aResolve)](
+                 const net::DatagramSendPromise::ResolveOrRejectValue& value) {
+               const nsresult status =
+                   value.IsResolve() ? NS_OK : value.RejectValue();
+               if (NS_FAILED(status)) {
+                 UDPSOCKET_LOG(("UDPSocketParent::DatagramAck: rv=0x%08x",
+                                static_cast<uint32_t>(status)));
+               }
+               resolve(UDPDatagramResult(
+                   static_cast<uint32_t>(status),
+                   value.IsResolve() ? value.ResolveValue() : TimeStamp()));
+             });
+  return IPC_OK();
+}
