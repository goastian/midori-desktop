GeckoProgram("midori-gio-launcher", linkage=None)
SOURCES += ["MidoriGioLauncher.cpp"]
LOCAL_INCLUDES += [".."]
CXXFLAGS += CONFIG["GLIB_CFLAGS"]
OS_LIBS += ["gio-2.0"]
OS_LIBS += CONFIG["GLIB_LIBS"]
DisableStlWrapping()
