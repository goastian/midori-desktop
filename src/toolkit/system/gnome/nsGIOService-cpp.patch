 using namespace mozilla;
+
+#if defined(XP_LINUX) && !defined(ANDROID)
+static Maybe<gboolean> TryLaunchManagedGioApplication(
+    GAppInfo* aApp, GFile* aFile, const char* aUri, GAppLaunchContext* aContext,
+    GError** aError) {
+  int file = -1;
+  int error = midori::OpenManagedCpuExternalProcess(file);
+  if (error) {
+    g_set_error(aError, G_IO_ERROR, g_io_error_from_errno(error),
+                "Cannot prepare external application: %s", g_strerror(error));
+    return Some(FALSE);
+  }
+  if (file < 0) return Nothing();
+  auto closeFile = MakeScopeExit([&] { close(file); });
+  if (!G_IS_DESKTOP_APP_INFO(aApp)) {
+    g_set_error_literal(
+        aError, G_IO_ERROR, G_IO_ERROR_NOT_SUPPORTED,
+        "Managed application launch requires desktop application info");
+    return Some(FALSE);
+  }
+  GUniquePtr<char> uri;
+  if (aFile) {
+    uri.reset(g_file_get_uri(aFile));
+    aUri = uri.get();
+  }
+  return Some(midori::LaunchExternalGioApplication(
+      G_DESKTOP_APP_INFO(aApp), aUri, aContext, file, aError));
+}
+#endif
 
