diff --git a/toolkit/components/search/SearchService.sys.mjs b/toolkit/components/search/SearchService.sys.mjs
index f06d2a2d080e88d17a5e74084bfa14178da22637..cb542e264df53f444c68d2f3f09c1bd9cce713af 100644
--- a/toolkit/components/search/SearchService.sys.mjs
+++ b/toolkit/components/search/SearchService.sys.mjs
@@ -3947,11 +3947,41 @@ class SearchDefaultOverrideAllowlistHandler {
     let searchProvider =
       extension.manifest.chrome_settings_overrides.search_provider;
 
+    // Normalize legacy providers that embed query parameters directly in
+    // `search_url` so comparisons remain stable across format migrations.
+    const normalizeProvider = provider => {
+      let normalized = {
+        ...provider,
+      };
+
+      if (
+        normalized.search_url &&
+        !normalized.search_url_get_params &&
+        normalized.search_url.includes("?")
+      ) {
+        let [base, query] = normalized.search_url.split("?", 2);
+        if (query) {
+          normalized.search_url = base;
+          normalized.search_url_get_params = query;
+        }
+      }
+
+      return normalized;
+    };
+
+    searchProvider = normalizeProvider(searchProvider);
+
     return entry.urls.some(
-      e =>
-        searchProvider.search_url == e.search_url &&
-        searchProvider.search_url_get_params == e.search_url_get_params &&
-        searchProvider.search_url_post_params == e.search_url_post_params
+      e => {
+        const normalizedEntry = normalizeProvider(e);
+        return (
+          searchProvider.search_url == normalizedEntry.search_url &&
+          searchProvider.search_url_get_params ==
+            normalizedEntry.search_url_get_params &&
+          searchProvider.search_url_post_params ==
+            normalizedEntry.search_url_post_params
+        );
+      }
     );
   }
 
