+      return (await fetchBookmarkByPosition({ parentGuid, index: itemIndex }, { db }))?.guid ?? null;
+    };
+    if (await at(index - 1) !== position.before || await at(index) !== position.after) {
+      throw midoriBookmarkError("bookmark_position_changed");
+    }
