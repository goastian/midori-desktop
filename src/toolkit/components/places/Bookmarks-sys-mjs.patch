+    if (position.parentGuid !== parentGuid || position.index !== index) {
+      throw midoriBookmarkError("bookmark_position_changed");
+    }
+    const parent = await fetchBookmark({ guid: parentGuid }, { db });
+    if (!parent || parent.type !== Bookmarks.TYPE_FOLDER || (originalParent && originalParent._id !== parent._id)) {
+      throw midoriBookmarkError("bookmark_parent_changed");
+    }
