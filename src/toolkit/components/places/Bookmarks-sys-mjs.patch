+const MIDORI_BOOKMARK_FIELDS = ["version", "kind", "parentGuid", "index", "title", "url", "dateAdded"];
+
+function midoriBookmarkError(code) {
+  const error = new Error(code);
+  error.code = code;
+  return error;
+}
+
+function ensureMidoriConditionActive(condition) {
+  if (condition?.signal?.aborted) {
+    throw midoriBookmarkError("bookmark_cancelled");
+  }
+}
+
+function midoriBookmarkValue(item) {
+  return {
+    version: 1,
+    kind: item.type === Bookmarks.TYPE_BOOKMARK ? "bookmark" : item.type === Bookmarks.TYPE_FOLDER ? "folder" : "separator",
+    parentGuid: item.parentGuid, index: item.index, title: item.title ?? "",
+    url: item.url?.href ?? null, dateAdded: item.dateAdded.getTime(),
+  };
+}
+
+function captureMidoriCondition(guid, options, operation) {
+  if (options.midoriCondition === undefined && options.midoriSignal === undefined) {
+    return null;
+  }
+  const input = options.midoriCondition;
+  const validGuid = value => typeof value === "string" && lazy.PlacesUtils.isValidGuid(value);
+  const validIndex = value => Number.isInteger(value) && value >= 0 && value <= 1000000;
+  if (!validGuid(guid) || lazy.PlacesUtils.isRootItem(guid) || Bookmarks.isVirtualRootItem(guid) ||
+      guid === Bookmarks.unsavedGuid || input?.version !== 1 || input.guid !== guid ||
+      Object.keys(input).length !== 4 || (options.midoriSignal !== undefined && typeof options.midoriSignal?.aborted !== "boolean")) {
+    throw new TypeError("Invalid Midori bookmark condition");
+  }
+  let expected = null;
+  if (operation !== "insert") {
+    const value = input.expected;
+    if (!value || Object.keys(value).length !== MIDORI_BOOKMARK_FIELDS.length || value.version !== 1 ||
+        !["bookmark", "folder", "separator"].includes(value.kind) || !validGuid(value.parentGuid) ||
+        !validIndex(value.index) || typeof value.title !== "string" || value.title.length > 4096 ||
+        (value.kind === "bookmark" ? typeof value.url !== "string" || value.url.length > 65536 : value.url !== null) ||
+        !Number.isSafeInteger(value.dateAdded) || value.dateAdded < 0 || value.dateAdded > 253402300799999) {
+      throw new TypeError("Invalid Midori bookmark snapshot");
+    }
+    expected = Object.fromEntries(MIDORI_BOOKMARK_FIELDS.map(field => [field, value[field]]));
+  } else if (input.expected !== null) {
+    throw new TypeError("A conditional insertion requires an absent bookmark");
+  }
+  let position = null;
+  if (operation !== "remove") {
+    const value = input.position;
+    if (!value || Object.keys(value).length !== 4 || !validGuid(value.parentGuid) || !validIndex(value.index) ||
+        ![value.before, value.after].every(id => id === null || (validGuid(id) && id !== guid)) ||
+        (value.before !== null && value.before === value.after)) {
+      throw new TypeError("Invalid Midori bookmark position");
+    }
+    position = { parentGuid: value.parentGuid, index: value.index, before: value.before, after: value.after };
+  } else if (input.position !== null) {
+    throw new TypeError("A conditional removal has no destination");
+  }
+  return { guid, expected, position, operation, signal: options.midoriSignal };
+}
+
+async function checkMidoriAncestors(db, parentGuid, guid) {
+  const roots = [Bookmarks.menuGuid, Bookmarks.toolbarGuid, Bookmarks.unfiledGuid, Bookmarks.mobileGuid];
+  const seen = new Set([guid]);
+  for (let depth = 0; depth < 256; depth++) {
+    if (roots.includes(parentGuid)) {
+      return;
+    }
+    if (seen.has(parentGuid) || [Bookmarks.rootGuid, Bookmarks.tagsGuid].includes(parentGuid)) {
+      throw midoriBookmarkError("bookmark_outside_roots");
+    }
+    seen.add(parentGuid);
+    const parent = await fetchBookmark({ guid: parentGuid }, { db });
+    if (!parent || parent.type !== Bookmarks.TYPE_FOLDER) {
+      throw midoriBookmarkError("bookmark_parent_changed");
+    }
+    parentGuid = parent.parentGuid;
+  }
+  throw midoriBookmarkError("bookmark_tree_too_deep");
+}
+
+async function checkMidoriCondition(db, condition, original, originalParent, parentGuid, index) {
+  if (!condition) {
+    return;
+  }
+  ensureMidoriConditionActive(condition);
+  const current = await fetchBookmark({ guid: condition.guid }, { db });
+  const actual = current ? midoriBookmarkValue(current) : null;
+  if (condition.expected === null ? current !== null : !current ||
+      !MIDORI_BOOKMARK_FIELDS.every(field => condition.expected[field] === actual[field])) {
+    throw midoriBookmarkError("bookmark_changed");
+  }
+  if (original && (!current || original._id !== current._id || original._parentId !== current._parentId ||
+      original.lastModified.getTime() !== current.lastModified.getTime())) {
+    throw midoriBookmarkError("bookmark_changed");
+  }
+  if (current) {
+    await checkMidoriAncestors(db, current.parentGuid, current.guid);
+  }
+  if (condition.operation === "remove") {
+    if (current.type === Bookmarks.TYPE_FOLDER && current._childCount !== 0) {
+      throw midoriBookmarkError("bookmark_folder_not_empty");
+    }
+  } else {
