+export async function modifyLoginForSync(logins, oldLogin, newLogin) {
+  const manager = logins
+    .QueryInterface(Ci.nsIInterfaceRequestor)
+    .getInterface(Ci.nsIVariant);
+  await manager.modifyLoginAsync(oldLogin, newLogin, true);
+}
+
+export async function removeLoginForSync(logins, login) {
+  const manager = logins
+    .QueryInterface(Ci.nsIInterfaceRequestor)
+    .getInterface(Ci.nsIVariant);
+  await manager.removeLoginAsync(login, true);
+}
+
+export async function flushLoginManagerData(logins = Services.logins) {
+  const manager = logins
+    .QueryInterface(Ci.nsIInterfaceRequestor)
+    .getInterface(Ci.nsIVariant);
+  const storage = await manager._getStorage();
+  if (storage.backendName === "json") {
+    await storage._store.saveNow();
+  } else if (storage.backendName !== "rust") {
+    throw new Error("login_storage_persistence_unavailable");
+  }
 }
 
