diff --git a/toolkit/themes/shared/pictureinpicture/midori-pip.css b/toolkit/themes/shared/pictureinpicture/midori-pip.css
new file mode 100644
--- /dev/null
+++ b/toolkit/themes/shared/pictureinpicture/midori-pip.css
@@ -0,0 +1,325 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+:root[midori-pip-skin="compact"] {
+  --midori-pip-surface: rgba(17, 19, 24, 0.8);
+  --midori-pip-surface-strong: rgba(16, 18, 23, 0.9);
+  --midori-pip-border: 1px solid rgba(255, 255, 255, 0.12);
+  --midori-pip-border-subtle: 1px solid rgba(255, 255, 255, 0.08);
+  --midori-pip-shadow: 0 12px 32px rgba(0, 0, 0, 0.42);
+  --midori-pip-control-size: clamp(26px, 7vmax, 32px);
+  --midori-pip-controls-bottom: 8px;
+  --midori-pip-controls-radius: 999px;
+  --midori-pip-gap: 4px;
+}
+
+@keyframes midori-pip-controls-in {
+  from {
+    opacity: 0;
+    transform: translateY(6px);
+  }
+
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+:root[midori-pip-skin="compact"] #controls-bottom-gradient {
+  opacity: 0.28;
+  background: linear-gradient(0deg, rgba(0, 0, 0, 0.62) -8%, rgba(0, 0, 0, 0) 82%);
+}
+
+:root[midori-pip-skin="compact"] #controls-bottom {
+  bottom: var(--midori-pip-controls-bottom);
+  animation: midori-pip-controls-in 140ms ease;
+}
+
+:root[midori-pip-skin="compact"] .controls-bottom-lower {
+  margin-inline: 8px;
+  gap: var(--midori-pip-gap);
+}
+
+:root[midori-pip-skin="compact"] .start-controls,
+:root[midori-pip-skin="compact"] .center-controls,
+:root[midori-pip-skin="compact"] .end-controls {
+  padding: 2px;
+  border-radius: var(--midori-pip-controls-radius);
+  border: var(--midori-pip-border-subtle);
+  background-color: color-mix(in srgb, var(--midori-pip-surface) 88%, transparent);
+  box-shadow: var(--midori-pip-shadow);
+  gap: var(--midori-pip-gap);
+  backdrop-filter: blur(6px);
+}
+
+:root[midori-pip-skin="compact"] .control-button {
+  width: var(--midori-pip-control-size);
+  min-width: var(--midori-pip-control-size);
+  max-width: var(--midori-pip-control-size);
+  height: var(--midori-pip-control-size);
+  border-radius: var(--midori-pip-controls-radius);
+  background-size: 14px;
+}
+
+:root[midori-pip-skin="compact"] .control-button:hover:enabled {
+  background-color: rgba(255, 255, 255, 0.13);
+}
+
+:root[midori-pip-skin="compact"] #close,
+:root[midori-pip-skin="compact"] #unpip {
+  top: 10px;
+  border-radius: var(--midori-pip-controls-radius);
+  border: var(--midori-pip-border);
+  background-color: var(--midori-pip-surface-strong);
+  box-shadow: var(--midori-pip-shadow);
+  fill: #fff;
+}
+
+:root[midori-pip-skin="compact"] #close {
+  right: 10px;
+}
+
+:root[midori-pip-skin="compact"] #close[mac="true"] {
+  right: auto;
+  left: 10px;
+}
+
+:root[midori-pip-skin="compact"] #unpip {
+  left: 10px;
+}
+
+:root[midori-pip-skin="compact"] #unpip[mac="true"] {
+  left: auto;
+  right: 10px;
+}
+
+:root[midori-pip-skin="compact"] #close:is(:hover, :focus-visible),
+:root[midori-pip-skin="compact"] #unpip:is(:hover, :focus-visible) {
+  background-color: rgba(255, 255, 255, 0.18);
+}
+
+:root[midori-pip-skin="compact"] #timestamp {
+  width: auto;
+  min-width: 10ch;
+  font-size: 0.76rem;
+  letter-spacing: 0.01em;
+  text-align: center;
+  padding-inline: 10px;
+}
+
+:root[midori-pip-skin="compact"] .controls-bottom-upper {
+  width: calc(100% - 16px);
+  margin-inline: 8px;
+}
+
+:root[midori-pip-skin="compact"] #scrubber {
+  height: 5px;
+  border-radius: 999px;
+}
+
+:root[midori-pip-skin="compact"] #scrubber,
+:root[midori-pip-skin="compact"] #audio-scrubber {
+  border: none;
+}
+
+:root[midori-pip-skin="compact"] #scrubber::-moz-range-track,
+:root[midori-pip-skin="compact"] #audio-scrubber::-moz-range-track {
+  background-color: rgba(255, 255, 255, 0.22);
+}
+
+:root[midori-pip-skin="compact"] #scrubber::-moz-range-progress,
+:root[midori-pip-skin="compact"] #audio-scrubber::-moz-range-progress {
+  background-color: #fff;
+}
+
+:root[midori-pip-skin="compact"] #scrubber::-moz-range-thumb {
+  width: 9px;
+  height: 9px;
+  border: 2px solid #fff;
+}
+
+:root[midori-pip-skin="compact"] #settings {
+  right: 10px;
+  bottom: calc(var(--midori-pip-controls-bottom) + 46px);
+}
+
+:root[midori-pip-skin="compact"] #settings > .panel-fieldset {
+  border-radius: 12px;
+  border: var(--midori-pip-border);
+  background-color: var(--midori-pip-surface-strong);
+  box-shadow: var(--midori-pip-shadow);
+}
+
+:root[midori-pip-skin="compact"] #settings .arrow {
+  border-top-color: rgba(18, 20, 26, 0.96);
+}
+
+@media (width <= 440px) {
+  :root[midori-pip-skin="compact"] .start-controls {
+    border-color: transparent;
+    background: transparent;
+    box-shadow: none;
+    backdrop-filter: none;
+  }
+}
+
+/* ===========================================================================
+   ISLAND variant — floaty, glass-heavy, wider spacing
+   =========================================================================== */
+
+:root[midori-pip-skin="island"] {
+  --midori-pip-surface: rgba(10, 12, 18, 0.82);
+  --midori-pip-surface-strong: rgba(10, 12, 18, 0.88);
+  --midori-pip-border: 1px solid rgba(255, 255, 255, 0.10);
+  --midori-pip-border-subtle: 1px solid rgba(255, 255, 255, 0.06);
+  --midori-pip-shadow: 0 16px 48px rgba(0, 0, 0, 0.50);
+  --midori-pip-control-size: clamp(30px, 8vmax, 38px);
+  --midori-pip-controls-bottom: 14px;
+  --midori-pip-controls-radius: 16px;
+  --midori-pip-gap: 6px;
+}
+
+:root[midori-pip-skin="island"] #controls-bottom-gradient {
+  opacity: 0.22;
+  background: linear-gradient(0deg, rgba(0, 0, 0, 0.55) -6%, rgba(0, 0, 0, 0) 78%);
+}
+
+:root[midori-pip-skin="island"] #controls-bottom {
+  bottom: var(--midori-pip-controls-bottom);
+  animation: midori-pip-controls-in 180ms ease;
+}
+
+:root[midori-pip-skin="island"] .controls-bottom-lower {
+  /* Override 1fr grid so groups shrink to content and float as islands */
+  grid-template-columns: auto auto auto;
+  justify-content: center;
+  align-items: center;
+  margin-inline: 14px;
+  gap: 10px;
+}
+
+:root[midori-pip-skin="island"] .start-controls,
+:root[midori-pip-skin="island"] .center-controls,
+:root[midori-pip-skin="island"] .end-controls {
+  padding: 4px 8px;
+  border-radius: var(--midori-pip-controls-radius);
+  border: var(--midori-pip-border-subtle);
+  background-color: var(--midori-pip-surface);
+  box-shadow: var(--midori-pip-shadow);
+  gap: var(--midori-pip-gap);
+  backdrop-filter: blur(14px) saturate(1.3);
+}
+
+:root[midori-pip-skin="island"] .control-button {
+  width: var(--midori-pip-control-size);
+  min-width: var(--midori-pip-control-size);
+  max-width: var(--midori-pip-control-size);
+  height: var(--midori-pip-control-size);
+  border-radius: 12px;
+  background-size: 16px;
+}
+
+:root[midori-pip-skin="island"] .control-button:hover:enabled {
+  background-color: rgba(255, 255, 255, 0.12);
+}
+
+:root[midori-pip-skin="island"] #close,
+:root[midori-pip-skin="island"] #unpip {
+  top: 14px;
+  border-radius: 14px;
+  border: var(--midori-pip-border);
+  background-color: var(--midori-pip-surface-strong);
+  box-shadow: var(--midori-pip-shadow);
+  fill: #fff;
+  backdrop-filter: blur(14px) saturate(1.3);
+}
+
+:root[midori-pip-skin="island"] #close {
+  right: 14px;
+}
+
+:root[midori-pip-skin="island"] #close[mac="true"] {
+  right: auto;
+  left: 14px;
+}
+
+:root[midori-pip-skin="island"] #unpip {
+  left: 14px;
+}
+
+:root[midori-pip-skin="island"] #unpip[mac="true"] {
+  left: auto;
+  right: 14px;
+}
+
+:root[midori-pip-skin="island"] #close:is(:hover, :focus-visible),
+:root[midori-pip-skin="island"] #unpip:is(:hover, :focus-visible) {
+  background-color: rgba(255, 255, 255, 0.16);
+}
+
+:root[midori-pip-skin="island"] #timestamp {
+  width: auto;
+  min-width: 12ch;
+  font-size: 0.82rem;
+  letter-spacing: 0.02em;
+  text-align: center;
+  padding-inline: 14px;
+}
+
+:root[midori-pip-skin="island"] .controls-bottom-upper {
+  width: calc(100% - 28px);
+  margin-inline: 14px;
+}
+
+:root[midori-pip-skin="island"] #scrubber {
+  height: 6px;
+  border-radius: 999px;
+}
+
+:root[midori-pip-skin="island"] #scrubber,
+:root[midori-pip-skin="island"] #audio-scrubber {
+  border: none;
+}
+
+:root[midori-pip-skin="island"] #scrubber::-moz-range-track,
+:root[midori-pip-skin="island"] #audio-scrubber::-moz-range-track {
+  background-color: rgba(255, 255, 255, 0.20);
+}
+
+:root[midori-pip-skin="island"] #scrubber::-moz-range-progress,
+:root[midori-pip-skin="island"] #audio-scrubber::-moz-range-progress {
+  background-color: #fff;
+}
+
+:root[midori-pip-skin="island"] #scrubber::-moz-range-thumb {
+  width: 12px;
+  height: 12px;
+  border: 2px solid #fff;
+}
+
+:root[midori-pip-skin="island"] #settings {
+  right: 14px;
+  bottom: calc(var(--midori-pip-controls-bottom) + 60px);
+}
+
+:root[midori-pip-skin="island"] #settings > .panel-fieldset {
+  border-radius: 16px;
+  border: var(--midori-pip-border);
+  background-color: var(--midori-pip-surface-strong);
+  box-shadow: var(--midori-pip-shadow);
+  backdrop-filter: blur(14px) saturate(1.3);
+}
+
+:root[midori-pip-skin="island"] #settings .arrow {
+  border-top-color: rgba(12, 14, 20, 0.92);
+}
+
+@media (width <= 440px) {
+  :root[midori-pip-skin="island"] .start-controls {
+    border-color: transparent;
+    background: transparent;
+    box-shadow: none;
+    backdrop-filter: none;
+  }
+}
