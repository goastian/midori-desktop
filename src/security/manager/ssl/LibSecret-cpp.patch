+static nsresult RetrieveSecretWithoutPrompt(const nsACString& aLabel,
+                                            nsACString& aSecret) {
+  aSecret.Truncate();
+  if (!secret_service_search_sync || !secret_item_get_locked ||
+      !secret_item_get_secret || !secret_value_get_text ||
+      !secret_value_unref) {
+    return NS_ERROR_NOT_IMPLEMENTED;
+  }
+  GHashTable* attributes = g_hash_table_new(g_str_hash, g_str_equal);
+  auto freeAttributes = MakeScopeExit([&] { g_hash_table_unref(attributes); });
+  const nsCString& label = PromiseFlatCString(aLabel);
+  g_hash_table_insert(attributes, const_cast<char*>("string"),
+                      const_cast<char*>(label.get()));
+  GUniquePtr<GError> error;
+  GList* items = secret_service_search_sync(nullptr, &kSchema, attributes,
+                                            SECRET_SEARCH_LOAD_SECRETS, nullptr,
+                                            getter_Transfers(error));
+  auto freeItems =
+      MakeScopeExit([&] { g_list_free_full(items, g_object_unref); });
+  if (error) {
+    return error->domain == secret_error_get_quark() &&
+                   error->code == SECRET_ERROR_IS_LOCKED
+               ? NS_ERROR_ABORT
+               : NS_ERROR_FAILURE;
+  }
+  if (!items) {
+    return NS_ERROR_NOT_AVAILABLE;
+  }
+  auto* item = static_cast<SecretItem*>(items->data);
+  if (secret_item_get_locked(item)) {
+    return NS_ERROR_ABORT;
+  }
+  SecretValue* value = secret_item_get_secret(item);
+  if (!value) {
+    return NS_ERROR_ABORT;
+  }
+  auto freeValue = MakeScopeExit([&] { secret_value_unref(value); });
+  const char* text = secret_value_get_text(value);
+  return text ? Base64Decode(nsDependentCString(text), aSecret)
+              : NS_ERROR_FAILURE;
+}
