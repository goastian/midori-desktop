# Setting the compiler based on the existence of clang bin directory
if test -d "$HOME/.mozbuild/clang/bin"; then
    export CC="$HOME/.mozbuild/clang/bin/clang"
    export CXX="$HOME/.mozbuild/clang/bin/clang++"
else
    export CC=clang
    export CXX=clang++
fi

# Target selection (always applied when SURFER_COMPAT is set)
if test "$SURFER_COMPAT" = "x86_64"; then
    ac_add_options --target=x86_64-pc-linux
    ac_add_options --enable-eme=widevine
elif test "$SURFER_COMPAT" = "aarch64"; then
    ac_add_options --target=aarch64-linux-gnu
    # EME/Widevine is not available for Linux aarch64 (only x86/x86_64)

    # override LTO settings for cross-compilation
    export MOZ_LTO=cross,thin
    ac_add_options --enable-lto=cross,thin

    # Use aarch64 sysroot if available (for cross-compilation from x86_64)
    if test -d "$HOME/.mozbuild/sysroot-aarch64-linux-gnu"; then
        ac_add_options --with-sysroot="$HOME/.mozbuild/sysroot-aarch64-linux-gnu"
    fi
fi

if test "$MIDORI_RELEASE"; then
    if test "$SURFER_COMPAT" = "x86_64"; then
        # Enable Profile Guided Optimization
        if test "$MIDORI_GA_DISABLE_PGO"; then
        export MIDORI_DUMMY=1
        else
        export MOZ_PGO=1
        ac_add_options MOZ_PGO=1
        fi

        # Optimization flags for x86_64
        ac_add_options --enable-optimize="-O3 -w -ftree-vectorize -mfpmath=sse -mprfchw -msse3 -mcx16 -msahf"

        export LDFLAGS="$LDFLAGS -Wl,-O3"
    elif test "$SURFER_COMPAT" = "aarch64"; then
        ac_add_options --enable-optimize="-O3"

        export CFLAGS="$CFLAGS -O3"
        export CPPFLAGS="$CPPFLAGS -O3"
        export CXXFLAGS="$CXXFLAGS -O3"
        export LDFLAGS="$LDFLAGS -Wl,-O3"
    fi

    # Disable DMD and ELF hacks, enable linker lld
    ac_add_options --disable-dmd
    ac_add_options --enable-linker=lld
    ac_add_options --disable-elf-hack
    ac_add_options --disable-necko-wifi

    # Stripping options for release builds
    ac_add_options --enable-install-strip
    ac_add_options --enable-strip
    export STRIP_FLAGS="--strip-debug --strip-unneeded"
fi

# Common options
ac_add_options --enable-alsa
ac_add_options --enable-pulseaudio