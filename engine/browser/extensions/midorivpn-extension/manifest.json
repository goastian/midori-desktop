{
  "manifest_version": 3,
  "name": "MidoriVPN",
  "description": "Surf the web safely and privately with Midori VPN",
  "version": "2.0.0",
  "author": "Astian, Inc.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "<all_urls>"
  ],
  "optional_permissions": [
    "proxy",
    "tabs",
    "webRequest",
    "webNavigation",
    "webRequestBlocking"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "midorivpn@astian.org",
      "strict_min_version": "114.0"
    }
  }
}